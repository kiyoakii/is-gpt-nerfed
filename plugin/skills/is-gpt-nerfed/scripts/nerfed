#!/usr/bin/env python3
"""dgc — is-gpt-nerfed: transparent, local detection of silent model downgrades in Codex sessions.

Three layers, all local, nothing leaves the machine:

  passive  Codex lifecycle hooks feed every turn into `nerfed hook`. The session rollout (JSONL) is scanned
           incrementally for silent model / reasoning-effort / context-window changes and for hidden
           internal models. Zero tokens.
  active   A ModelTrace fingerprint probe (https://github.com/xqy2006/ModelTrace, MIT): the thread is forked
           `ephemeral: true` N times at its last completed turn (the mechanism behind Codex's `/side`), each
           fork is asked for a long "random" integer sequence, and the sequences are attributed to a model
           with ModelTrace's calibrated fingerprint bank. Expected model ≠ fingerprint → the pet speaks up.
           Inside a `/side` conversation the model answers the same challenge directly.
  card     Verdicts arrive as a card, a macOS notification, a system message in the thread and
           (optionally) a sound. Optional Guard-style halt: deny work tools after a mismatch until `nerfed resume`.

State lives under $NERFED_HOME (default: $CODEX_HOME/is-gpt-nerfed, i.e. ~/.codex/is-gpt-nerfed).
"""
from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import fcntl
import glob
import json
import os
import random
import re
import shutil
import sqlite3
import subprocess
import sys
import time
import uuid

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import codex_appserver as cas  # noqa: E402
import modeltrace_core as core  # noqa: E402
import responses_meta  # noqa: E402

VERSION = "0.5.1"
DGC_BIN = os.path.abspath(__file__)
SKILL_DIR = os.path.dirname(HERE)
PLUGIN_ROOT = os.environ.get("PLUGIN_ROOT") or os.environ.get("CLAUDE_PLUGIN_ROOT") or os.path.dirname(os.path.dirname(SKILL_DIR))
CODEX_HOME = os.environ.get("CODEX_HOME") or os.path.join(os.path.expanduser("~"), ".codex")
NERFED_HOME = os.environ.get("NERFED_HOME") or os.path.join(CODEX_HOME, "is-gpt-nerfed")
CONFIG_PATH = os.path.join(NERFED_HOME, "config.json")
EVENTS_PATH = os.path.join(NERFED_HOME, "events.jsonl")
PROBES_INDEX = os.path.join(NERFED_HOME, "probes.jsonl")
SESSIONS_DIR = os.path.join(NERFED_HOME, "sessions")
PROBES_DIR = os.path.join(NERFED_HOME, "probes")
ERRORS_PATH = os.path.join(NERFED_HOME, "errors.log")
WORKER_LOG = os.path.join(NERFED_HOME, "worker.log")
LOG_PATH = os.path.join(NERFED_HOME, "log.jsonl")            # structured activity log (nerfed log)
ACCOUNT_PATH = os.path.join(NERFED_HOME, "account.json")     # last seen Codex account (hash, masked label)
HOOKS_STATUS_PATH = os.path.join(NERFED_HOME, "hooks_status.json")
UPDATE_PATH = os.path.join(NERFED_HOME, "update.json")
RELEASES_API = "https://api.github.com/repos/kiyoakii/is-gpt-nerfed/releases/latest"
RELEASES_URL = "https://github.com/kiyoakii/is-gpt-nerfed/releases"
UPDATE_INTERVAL_S = 600  # every 10 minutes while the app is open; well inside GitHub's unauthenticated 60/hour
STATE_PATH = os.path.join(NERFED_HOME, "state.json")
UNKNOWN_ACCOUNT = "unknown"
BANK_PATH = os.path.join(PLUGIN_ROOT, "assets", "modeltrace", "unified_bank.json")

PLUGIN_NAME = "is-gpt-nerfed"
MARKETPLACE_NAME = "is-gpt-nerfed"
SKILL_CMD = "$is-gpt-nerfed"
SIDE_CMD = "/side $is-gpt-nerfed"
APP_CODEX_BINS = [
    "/Applications/ChatGPT.app/Contents/Resources/codex",
    "/Applications/Codex.app/Contents/Resources/codex",
]
CODEX_NOTIFICATION_WAV = "/Applications/ChatGPT.app/Contents/Resources/codex-notification.wav"

DEFAULT_CONFIG = {
    "frequency": "30m",              # "Nm" (minutes of activity) | "turns:N" | "manual"
    "mode": "auto",                  # auto: background fork probe when due | nudge: only remind the user
    "queries": 3,                    # parallel ephemeral forks per probe (ModelTrace calibrates 1..3)
    "parallel": True,
    "languages": ["zh", "en"],
    "probe_timeout_s": 300,          # a fork that has not answered by then is replaced once (slow models must not drop out)
    "passive": True,                 # scan rollouts on every Stop hook
    "notify": True,                  # macOS notification when the pet has something to say
    "notify_on_ok": False,           # also notify on MATCH verdicts
    "announce_ok": False,            # also push MATCH verdicts into the thread
    "sound": True,                   # Codex notification sound on a downgrade verdict
    "halt_on_mismatch": False,       # Guard-style: deny work tools after a mismatch until `nerfed resume`
    "mismatch_confidence": 0.8,      # MISMATCH needs p(top) ≥ this, p(declared) ≤ 1-this and a score margin ≥ 0.5σ
    "confirm_uncertain": False,      # opt in: a SUSPICIOUS first round triggers one more round (three more answers)
    "check_updates": True,           # every 10 min, one request to GitHub for the latest release tag; off = no network at all
    "probe_originator": "auto",      # the client the probes identify as: auto = the session's own (Codex Desktop, or the CLI)
    "hide_titles": False,            # panel shows "Session 1…N" and hides the account label (screenshot mode)
    "fresh_frequency": "manual",     # heartbeat for the fresh-session probe: "30m", "2h" … (time only; "manual" = off)
    "served_check": True,            # also ask the server which model it says answered (one small request per probe); the fingerprint always runs
    "served_check_timeout_s": 10,
    "codex_bin": None,
    "nudge_cooldown_turns": 4,
}

EFFORTS = ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
SIZE_TAGS = (("nano", 0), ("mini", 1), ("spark", 1), ("lite", 1), ("small", 1), ("flash", 1),
             ("reserve", 1), ("auto-review", 1))

# --------------------------------------------------------------------------------------- utilities


def now() -> float:
    return time.time()


def iso(ts: float | None = None) -> str:
    return dt.datetime.fromtimestamp(ts if ts is not None else now(), dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def ensure_dirs() -> None:
    for d in (NERFED_HOME, SESSIONS_DIR, PROBES_DIR):
        os.makedirs(d, exist_ok=True)


def read_json(path: str, default=None):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def write_json(path: str, obj) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, indent=2, ensure_ascii=False)
    os.replace(tmp, path)


def append_jsonl(path: str, obj) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(obj, ensure_ascii=False) + "\n")


def iter_jsonl(path: str):
    try:
        with open(path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        yield json.loads(line)
                    except Exception:
                        continue
    except OSError:
        return


def tail_jsonl(path: str, n: int) -> list:
    return list(iter_jsonl(path))[-n:]


def log_event(kind: str, level: str = "info", **fields) -> None:
    """Append one line to the activity log. Every decision the tool makes goes through here so the whole
    process can be reconstructed later (`nerfed log`): account switches, schedule decisions, each probe's
    forks and verdict, passive findings, hook trust, config changes, errors."""
    try:
        os.makedirs(NERFED_HOME, exist_ok=True)
        entry = {"ts": iso(), "kind": kind, "level": level, "pid": os.getpid()}
        entry.update({k: v for k, v in fields.items() if v is not None})
        with open(LOG_PATH, "a", encoding="utf-8") as f:
            f.write(json.dumps(entry, ensure_ascii=False, default=str) + "\n")
    except Exception:
        pass


def log_error(msg: str) -> None:
    try:
        os.makedirs(NERFED_HOME, exist_ok=True)
        with open(ERRORS_PATH, "a", encoding="utf-8") as f:
            f.write(f"{iso()} {msg}\n")
    except Exception:
        pass
    log_event("error", level="error", message=str(msg)[:2000])


def short(s, n: int = 8) -> str:
    s = str(s or "")
    return s[:n] + "…" if len(s) > n else s


def safe_name(s: str) -> str:
    return re.sub(r"[^A-Za-z0-9._-]", "_", str(s))[:120] or "unknown"


def pid_alive(pid) -> bool:
    try:
        os.kill(int(pid), 0)
        return True
    except Exception:
        return False


# ----------------------------------------------------------------------------------------- config


# Values an older version wrote into config.json as part of a full defaults dump; nobody chooses these on purpose,
# so a saved copy equal to one of them is treated as "not set" and the current default applies.
OLD_DEFAULTS = {"probe_timeout_s": 180, "confirm_uncertain": True}


def load_config() -> dict:
    cfg = dict(DEFAULT_CONFIG)
    saved = read_json(CONFIG_PATH, {}) or {}
    cfg.update({k: v for k, v in saved.items() if not (k in OLD_DEFAULTS and v == OLD_DEFAULTS[k])})
    return cfg


def save_config(cfg: dict) -> None:
    """Only what differs from the defaults is written, so the defaults can change with the code."""
    write_json(CONFIG_PATH, {k: v for k, v in cfg.items() if k not in DEFAULT_CONFIG or v != DEFAULT_CONFIG[k]})


def parse_frequency(s) -> tuple[str, int]:
    s = str(s or "").strip().lower()
    if s in ("", "manual", "off", "never", "none"):
        return ("manual", 0)
    m = re.match(r"^(?:every\s+)?(\d+)\s*(turns?|t|prompts?)$", s) or re.match(r"^turns?[:=](\d+)$", s)
    if m:
        return ("turns", max(1, int(m.group(1))))
    m = re.match(r"^(?:every\s+)?(\d+)\s*(m|min|mins|minutes?)$", s) or re.match(r"^min(?:ute)?s?[:=](\d+)$", s)
    if m:
        return ("minutes", max(1, int(m.group(1))))
    m = re.match(r"^(?:every\s+)?(\d+)\s*(h|hr|hrs|hours?)$", s) or re.match(r"^hours?[:=](\d+)$", s)
    if m:
        return ("minutes", max(1, int(m.group(1)) * 60))
    raise ValueError(f"unrecognized frequency {s!r} (use e.g. 'turns:8', '30m', '2h', 'manual')")


def coerce_config_value(key: str, value: str):
    if key in ("passive", "notify", "notify_on_ok", "announce_ok", "sound", "parallel", "halt_on_mismatch", "confirm_uncertain", "check_updates",
               "hide_titles", "served_check"):
        return str(value).strip().lower() in ("1", "true", "yes", "on")
    if key == "mismatch_confidence":
        v = float(value)
        if not 0.5 <= v <= 0.99:
            raise ValueError("mismatch_confidence must be between 0.5 and 0.99")
        return v
    if key in ("nudge_cooldown_turns", "probe_timeout_s", "served_check_timeout_s"):
        return max(1, int(value))
    if key == "queries":
        return max(1, min(3, int(value)))
    if key == "languages":
        langs = [v.strip() for v in re.split(r"[,\s]+", str(value)) if v.strip()]
        bad = [v for v in langs if v not in cas.PROMPTS]
        if bad or not langs:
            raise ValueError(f"languages must be a comma-separated subset of {', '.join(cas.PROMPTS)}")
        return langs
    if key == "frequency":
        parse_frequency(value)
        return value
    if key == "fresh_frequency":
        kind, _ = parse_frequency(value)
        if kind == "turns":
            raise ValueError("fresh_frequency is time-based: use e.g. 30m, 2h or manual")
        return value
    if key == "mode":
        v = str(value).strip().lower()
        if v not in ("auto", "nudge"):
            raise ValueError("mode must be auto or nudge")
        return v
    if key == "codex_bin":
        return None if value in ("", "null", "none") else value
    return value


# ---------------------------------------------------------------------------------- model catalog


def load_catalog() -> dict:
    d = read_json(os.path.join(CODEX_HOME, "models_cache.json"), {}) or {}
    models = d.get("models") if isinstance(d, dict) else None
    if isinstance(models, dict):
        models = list(models.values())
    out = {}
    for m in models or []:
        if isinstance(m, dict) and m.get("slug"):
            out[m["slug"]] = {"display_name": m.get("display_name"), "visibility": m.get("visibility"),
                              "context_window": m.get("context_window"), "priority": m.get("priority"),
                              "upgrade": m.get("upgrade"),  # the catalog's own successor pointer, when a model is being replaced
                              "supported_reasoning_levels": [(lvl.get("effort") if isinstance(lvl, dict) else lvl)
                                                             for lvl in (m.get("supported_reasoning_levels") or [])]}
    return out


def hidden_models(cat: dict | None = None) -> frozenset:
    cat = load_catalog() if cat is None else cat
    return frozenset(s.lower() for s, m in cat.items() if (m.get("visibility") or "").lower() == "hide")


def model_version(slug: str) -> tuple[int, int] | None:
    """The generation in a slug: gpt-6-astra → (6, 0), gpt-5.6-sol → (5, 6), claude-opus-4-8 → (4, 8); None if there is none."""
    m = re.search(r"(?:^|-)(\d+)(?:[.\-](\d{1,2}))?(?=$|-)", slug)
    return (int(m.group(1)), int(m.group(2) or 0)) if m else None


def model_size(slug: str) -> int:
    """Size tier from the slug's own words: 0 nano, 1 mini/spark/lite/small/flash/reserve/auto-review, 2 the plain model, 3 pro/ultra."""
    size = 2
    for tag, val in SIZE_TAGS:
        if tag in slug:
            size = min(size, val)
    if re.search(r"(^|-)(pro|ultra)($|-)", slug):
        size = 3
    return size


def model_rank(slug: str | None) -> tuple:
    """(generation, size tier) of a slug, catalog-free. Kept for the simple orderings; compare_models is the real thing."""
    s = normalize_model(slug)
    v = model_version(s) or (0, 0)
    return (v[0] + v[1] / 100.0, model_size(s))


def model_profile(slug: str | None, cat: dict) -> dict:
    s = normalize_model(slug)
    entry = cat.get(s) or {}
    levels = [effort_idx(x) for x in entry.get("supported_reasoning_levels") or []]
    levels = [x for x in levels if x is not None]
    return {"slug": s, "version": model_version(s), "size": model_size(s), "hidden": (entry.get("visibility") or "").lower() == "hide",
            "priority": entry.get("priority"), "max_effort": max(levels) if levels else None, "ctx": entry.get("context_window"),
            "upgrade": normalize_model(entry.get("upgrade")) if entry.get("upgrade") else None}


def compare_models(old: str | None, new: str | None, cat: dict | None = None) -> dict:
    """Is `new` a better or a worse model than `old`? Not a fixed list: the signals, in order of trust, are
    Codex's own catalog succession (`upgrade`), hidden internal models, the generation in the slug, the size tier in
    the slug, then the catalog's ranking (priority), the highest reasoning effort a model supports, and the context
    window. Returns {direction: upgrade|downgrade|lateral, confidence: high|medium|low, reason}."""
    cat = load_catalog() if cat is None else cat
    a, b = model_profile(old, cat), model_profile(new, cat)

    def out(direction: str, confidence: str, reason: str) -> dict:
        return {"direction": direction, "confidence": confidence, "reason": reason}

    if a["slug"] == b["slug"]:
        return out("lateral", "high", "same model")
    if a["upgrade"] and a["upgrade"] == b["slug"]:
        return out("upgrade", "high", f"Codex's catalog names {b['slug']} as the successor of {a['slug']}")
    if b["upgrade"] and b["upgrade"] == a["slug"]:
        return out("downgrade", "high", f"Codex's catalog names {a['slug']} as the successor of {b['slug']}")
    if b["hidden"] and not a["hidden"]:
        return out("downgrade", "high", f"{b['slug']} is an internal model Codex does not list")
    if a["hidden"] and not b["hidden"]:
        return out("upgrade", "medium", f"back from the internal model {a['slug']}")
    if a["version"] and b["version"] and a["version"] != b["version"]:
        newer = b["version"] > a["version"]
        fmt = lambda v: f"{v[0]}.{v[1]}" if v[1] else str(v[0])
        if a["size"] == b["size"]:
            return out("upgrade" if newer else "downgrade", "high",
                       f"{'newer' if newer else 'older'} generation ({fmt(b['version'])} vs {fmt(a['version'])})")
        return out("upgrade" if newer else "downgrade", "medium",
                   f"{'newer' if newer else 'older'} generation ({fmt(b['version'])} vs {fmt(a['version'])}) but a different size tier")
    if a["size"] != b["size"]:
        larger = b["size"] > a["size"]
        return out("upgrade" if larger else "downgrade", "high", f"{'larger' if larger else 'smaller'} size tier")
    if a["priority"] is not None and b["priority"] is not None and a["priority"] != b["priority"]:
        above = b["priority"] < a["priority"]
        return out("upgrade" if above else "downgrade", "medium", f"Codex lists {b['slug']} {'above' if above else 'below'} {a['slug']}")
    if a["max_effort"] is not None and b["max_effort"] is not None and a["max_effort"] != b["max_effort"]:
        higher = b["max_effort"] > a["max_effort"]
        return out("upgrade" if higher else "downgrade", "low", f"supports a {'higher' if higher else 'lower'} top reasoning effort")
    if a["ctx"] and b["ctx"] and a["ctx"] != b["ctx"]:
        larger = b["ctx"] > a["ctx"]
        return out("upgrade" if larger else "downgrade", "low", f"{'larger' if larger else 'smaller'} context window")
    return out("lateral", "low", "same generation and size; the catalog does not rank them")


def classify_change(old: str | None, new: str | None, cat: dict | None = None) -> str:
    return compare_models(old, new, cat)["direction"]


def effort_idx(e) -> int | None:
    try:
        return EFFORTS.index(str(e or "").lower())
    except ValueError:
        return None


def normalize_model(slug) -> str:
    s = str(slug or "").strip().lower()
    return s.split("/", 1)[1] if "/" in s else s


def config_toml_model() -> tuple[str | None, str | None]:
    model = effort = None
    try:
        with open(os.path.join(CODEX_HOME, "config.toml"), "r", encoding="utf-8") as f:
            for line in f:
                s = line.strip()
                if s.startswith("["):
                    break
                m = re.match(r'^model\s*=\s*"([^"]+)"', s)
                if m:
                    model = m.group(1)
                m = re.match(r'^model_reasoning_effort\s*=\s*"([^"]+)"', s)
                if m:
                    effort = m.group(1)
    except OSError:
        pass
    return model, effort


_BANK = None


def current_account() -> dict:
    """Identify the signed-in Codex account from auth.json: a hash of the account id (never the id itself),
    a masked e-mail for display and the plan type. Nothing here leaves the machine."""
    import base64
    import hashlib
    d = read_json(os.path.join(CODEX_HOME, "auth.json"), {}) or {}
    tokens = d.get("tokens") or {}
    account_id = tokens.get("account_id")
    email = plan = None
    tok = tokens.get("id_token")
    if isinstance(tok, str) and tok.count(".") == 2:
        try:
            payload = tok.split(".")[1]
            payload += "=" * (-len(payload) % 4)
            pl = json.loads(base64.urlsafe_b64decode(payload))
            email = pl.get("email")
            auth = pl.get("https://api.openai.com/auth") or {}
            plan = auth.get("chatgpt_plan_type")
            account_id = account_id or auth.get("chatgpt_account_id")
        except Exception:
            pass
    if not account_id and d.get("OPENAI_API_KEY"):
        account_id = "apikey:" + hashlib.sha256(str(d["OPENAI_API_KEY"]).encode()).hexdigest()[:16]
    if not account_id:
        return {"id": "local", "label": "no account", "plan": None}
    local, _, domain = (email or "").partition("@")
    label = f"{local[:1]}…@{domain}" if domain else "signed in"
    return {"id": hashlib.sha256(str(account_id).encode()).hexdigest()[:12], "label": label, "plan": plan}


def stale_for_account(record_account: str | None, current: str) -> bool:
    """Threads are local and shared across Codex accounts, but nerfing may be per account: a verdict obtained
    under another account (or before accounts were recorded) says nothing about this one."""
    return record_account == UNKNOWN_ACCOUNT or (bool(record_account) and record_account != current)


def account_state(record_account: str | None, current: str | None) -> str:
    if record_account == UNKNOWN_ACCOUNT:
        return "unknown"
    if record_account and current and record_account != current:
        return "other"
    return "current"


def note_account(source: str) -> dict:
    """Remember the signed-in account and log every switch (hashes and masked labels only)."""
    acct = current_account()
    prev = read_json(ACCOUNT_PATH, {}) or {}
    t = now()
    if prev.get("id") != acct["id"]:
        if prev.get("id"):
            log_event("account_switch", source=source, from_id=prev.get("id"), from_label=prev.get("label"),
                      to_id=acct["id"], to_label=acct["label"], plan=acct.get("plan"))
            rec = {**acct, "first_seen": iso(t), "switched_at": iso(t), "switched_ts": t, "source": source,
                   "previous": {k: prev.get(k) for k in ("id", "label", "plan")}}
        else:
            log_event("account_seen", source=source, id=acct["id"], label=acct["label"], plan=acct.get("plan"))
            rec = {**acct, "first_seen": iso(t), "switched_at": None, "switched_ts": None, "source": source, "previous": None}
    else:
        rec = {**prev, **acct}
    rec["last_seen"] = iso(t)
    write_json(ACCOUNT_PATH, rec)
    return rec


def load_bank() -> dict:
    global _BANK
    if _BANK is None:
        if not os.path.exists(BANK_PATH):
            raise SystemExit(f"fingerprint bank missing: {BANK_PATH}")
        _BANK = core.load_bank(BANK_PATH)
    return _BANK


# ------------------------------------------------------------------------------- codex state DB


def state_db_path() -> str | None:
    cands = sorted(glob.glob(os.path.join(CODEX_HOME, "state_*.sqlite")),
                   key=lambda p: int(re.search(r"state_(\d+)", p).group(1)))
    return cands[-1] if cands else None


def db_query(sql: str, params=()) -> list[dict]:
    path = state_db_path()
    if not path:
        return []
    try:
        con = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=2)
        con.row_factory = sqlite3.Row
        try:
            return [dict(r) for r in con.execute(sql, params).fetchall()]
        finally:
            con.close()
    except Exception as e:
        log_error(f"db_query failed: {e}")
        return []


THREAD_COLS = "id, rollout_path, thread_source, cwd, model, reasoning_effort, archived, updated_at_ms, title, name, originator"
# (originator distinguishes Codex Desktop / CLI sessions from one-shot `codex exec` runs)


def db_thread(tid: str) -> dict | None:
    rows = db_query(f"SELECT {THREAD_COLS} FROM threads WHERE id = ?", (tid,))
    return rows[0] if rows else None


def db_recent_main_threads(limit: int = 25) -> list[dict]:
    return db_query(f"SELECT {THREAD_COLS} FROM threads WHERE archived = 0 AND (thread_source IS NULL OR thread_source != 'subagent') "
                    f"ORDER BY updated_at_ms DESC LIMIT ?", (limit,))


def db_recent_main_thread(cwd: str | None, exclude: str | None = None) -> dict | None:
    rows = [r for r in db_recent_main_threads() if r["id"] != exclude]
    if cwd:
        for r in rows:
            if r.get("cwd") == cwd:
                return r
    return rows[0] if rows else None


def thread_is_persisted(tid: str) -> bool:
    row = db_thread(tid)
    return bool(row and row.get("rollout_path") and os.path.exists(row["rollout_path"]))


# ------------------------------------------------------------------------------- rollout scanner


def new_scan_state() -> dict:
    return {"cursor": 0, "model": None, "first_model": None, "effort": None, "ctx": None, "tier": None,
            "applied": None, "turns": 0, "instructions_family": None, "originator": None,
            "cli_version": None, "models_seen": {}, "efforts_seen": {}, "ev_keys": []}


def scan_rollout(path: str, scan: dict, hidden=frozenset(), cap_bytes: int = 64 << 20) -> list[dict]:
    """Incrementally scan a Codex rollout JSONL file. Mutates `scan`; returns NEW evidence records.

    hard  -> something changed underneath the user with no settings change (or a hidden model ran)
    soft  -> a change that went through thread settings; needs the user to confirm they chose it
    info  -> logged for completeness
    """
    new_ev: list[dict] = []

    def add(kind: str, severity: str, detail: str, ts=None, turn=None, **extra):
        key = f"{kind}|{detail}|{ts}"
        keys = scan.setdefault("ev_keys", [])
        if key in keys:
            return
        keys.append(key)
        usage = scan.get("usage_percent")
        new_ev.append({"ts": ts or iso(), "kind": kind, "severity": severity, "detail": detail, "turn_id": turn,
                       "usage_percent": usage, **extra})

    try:
        size = os.path.getsize(path)
    except OSError:
        return new_ev
    cur = int(scan.get("cursor") or 0)
    if cur > size:
        cur = 0
    if cur >= size:
        return new_ev
    with open(path, "rb") as f:
        f.seek(cur)
        data = f.read(min(size - cur, cap_bytes))
    end = data.rfind(b"\n")
    if end < 0:
        return new_ev
    for raw in data[:end].split(b"\n"):
        if not raw.strip():
            continue
        try:
            rec = json.loads(raw)
        except Exception:
            continue
        rtype, p, ts = rec.get("type"), rec.get("payload") or {}, rec.get("timestamp")
        if rtype == "session_meta":
            scan["originator"], scan["cli_version"] = p.get("originator"), p.get("cli_version")
            bi = p.get("base_instructions")
            text = bi.get("text") if isinstance(bi, dict) else (bi if isinstance(bi, str) else "")
            m = re.search(r"based on (GPT-[\w.\-]+)", text or "", re.I)
            if m:
                scan["instructions_family"] = m.group(1)
        elif rtype == "turn_context":
            model = p.get("model")
            settings = (p.get("collaboration_mode") or {}).get("settings") or {}
            effort = settings.get("reasoning_effort") or p.get("reasoning_effort") or p.get("effort")
            turn = p.get("turn_id")
            scan["turns"] = int(scan.get("turns") or 0) + 1
            applied = scan.get("applied") or {}
            if model:
                scan["models_seen"][model] = scan["models_seen"].get(model, 0) + 1
                if model.lower() in hidden:
                    add("hidden_model", "hard", f"hidden/internal model {model} ran a turn", ts, turn)
                if scan["model"] is None:
                    scan["model"] = scan["first_model"] = model
                elif model != scan["model"]:
                    cmp = compare_models(scan["model"], model)
                    change = cmp["direction"]
                    good = change == "upgrade" and cmp["confidence"] in ("high", "medium")  # a rollout to a better model: good news
                    if applied.get("model") == model:
                        add("applied_model_change", "soft" if change == "downgrade" else ("good" if good else "info"),
                            f"thread settings switched model {scan['model']} → {model} ({change})", ts, turn, why=cmp["reason"])
                    else:
                        add("silent_model_change", "hard" if change == "downgrade" else ("good" if good else "soft"),
                            f"model {scan['model']} → {model} with no settings change ({change})", ts, turn, why=cmp["reason"])
                    scan["model"] = model
            if effort:
                scan["efforts_seen"][effort] = scan["efforts_seen"].get(effort, 0) + 1
                if scan["effort"] is None:
                    scan["effort"] = effort
                elif effort != scan["effort"]:
                    oi, ni = effort_idx(scan["effort"]), effort_idx(effort)
                    lower = oi is not None and ni is not None and ni < oi
                    if applied.get("effort") == effort:
                        add("applied_effort_change", "soft" if lower else "info",
                            f"thread settings switched reasoning effort {scan['effort']} → {effort}", ts, turn)
                    else:
                        add("silent_effort_change", "hard" if lower else "soft",
                            f"reasoning effort {scan['effort']} → {effort} with no settings change", ts, turn)
                    scan["effort"] = effort
        elif rtype == "event_msg":
            et = p.get("type")
            if et == "thread_settings_applied":
                s = p.get("thread_settings") or {}
                scan["applied"] = {"model": s.get("model"), "effort": s.get("reasoning_effort"), "tier": s.get("service_tier"), "ts": ts}
                tier = s.get("service_tier")
                if tier:
                    if scan["tier"] is None:
                        scan["tier"] = tier
                    elif tier != scan["tier"]:  # speed tier, not intelligence: record only
                        add("service_tier_change", "info", f"service tier {scan['tier']} → {tier}", ts)
                        scan["tier"] = tier
            elif et == "token_count":
                # rate_limits is whichever limit family Codex parsed *last* from the response headers (families are
                # emitted in alphabetical order, so on plans with a separate GPT-5.3-Codex-Spark allowance it is that
                # bucket at 0% on every turn). It never identifies the model that answered, and a named bucket says
                # nothing about the real usage: only the unnamed default family feeds the "at the usage limit" label.
                rl = p.get("rate_limits") or {}
                pct = (rl.get("primary") or {}).get("used_percent")
                if isinstance(pct, (int, float)) and not rl.get("limit_name"):
                    scan["usage_percent"] = pct
                ctx = (p.get("info") or {}).get("model_context_window")
                if isinstance(ctx, int) and ctx > 0:
                    if scan["ctx"] is None:
                        scan["ctx"] = ctx
                    elif ctx != scan["ctx"]:
                        add("context_window_change", "hard" if ctx < scan["ctx"] else "info",
                            f"model context window {scan['ctx']} → {ctx}", ts)
                        scan["ctx"] = ctx
    scan["cursor"] = cur + end + 1
    return new_ev


def scan_full(path: str, hidden=None, cap_bytes: int = 256 << 20) -> tuple[dict, list[dict]]:
    scan = new_scan_state()
    ev = scan_rollout(path, scan, hidden if hidden is not None else hidden_models(), cap_bytes=cap_bytes)
    return scan, ev


# ------------------------------------------------------------------------------- session ledger


def session_path(sid: str) -> str:
    return os.path.join(SESSIONS_DIR, safe_name(sid) + ".json")


def new_session(sid: str) -> dict:
    return {"sid": sid, "created": iso(), "created_ts": now(), "updated": iso(), "cwd": None, "model": None,
            "transcript_path": None, "kind": "unknown", "thread_source": None, "parent_thread_id": None,
            "link_method": None, "turns": 0, "last_probe_turn": 0, "last_probe_ts": 0.0,
            "last_nudge_turn": -999, "last_nudge_ts": 0.0, "tools": [], "evidence": [],
            "scan": new_scan_state(), "ended": None, "hook_events": 0,
            "alerts": [], "halt": None, "probe_running": None, "requested": False, "probes": []}


def load_session(sid: str) -> dict:
    base = new_session(sid)
    st = read_json(session_path(sid))
    if st:
        base.update(st)
    return base


def save_session(st: dict) -> None:
    st["updated"] = iso()
    write_json(session_path(st["sid"]), st)


@contextlib.contextmanager
def locked_session(sid: str):
    """Load-modify-save under an exclusive file lock (hooks and background workers touch the same file)."""
    ensure_dirs()
    lock_path = session_path(sid) + ".lock"
    with open(lock_path, "a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            st = load_session(sid)
            yield st
            save_session(st)
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def all_sessions() -> list[dict]:
    out = []
    for p in glob.glob(os.path.join(SESSIONS_DIR, "*.json")):
        st = read_json(p)
        if st:
            out.append(st)
    out.sort(key=lambda s: s.get("updated") or "", reverse=True)
    return out


def link_session(st: dict) -> None:
    row = db_thread(st["sid"])
    if row:
        st["thread_source"] = row.get("thread_source")
        st["kind"] = "subagent" if row.get("thread_source") == "subagent" else "main"
        st["link_method"] = "state-db"
        if not st.get("transcript_path") and row.get("rollout_path") and os.path.exists(row["rollout_path"]):
            st["transcript_path"] = row["rollout_path"]
        if not st.get("model") and row.get("model"):
            st["model"] = row["model"]
        return
    if st.get("transcript_path") and os.path.exists(st["transcript_path"]):
        st["kind"], st["link_method"] = "main", "transcript-path"
        return
    parent = db_recent_main_thread(st.get("cwd"), exclude=st["sid"])
    if parent:
        st["parent_thread_id"], st["kind"], st["link_method"] = parent["id"], "side", "recent-main-thread-guess"
        if not st.get("model") and parent.get("model"):
            st["model"] = parent["model"]


ACTIVE_WINDOW_S = 15 * 60  # a thread with a hook event this recent is "active": shown so in the panel, in scope for `tick`


def probe_due(st: dict, cfg: dict, account: str | None = None) -> bool:
    try:
        kind, n = parse_frequency(cfg.get("frequency"))
    except ValueError:
        return False
    if kind == "manual":
        return False
    # a probe made under another Codex account does not count: the thread is unverified for this account
    switched = stale_for_account(st.get("last_probe_account"), account or current_account()["id"])
    last_probe_turn = 0 if switched else int(st.get("last_probe_turn") or 0)
    last_probe_ts = 0.0 if switched else float(st.get("last_probe_ts") or 0)
    if kind == "turns":
        since_probe = st["turns"] - last_probe_turn
        since_nudge = st["turns"] - int(st.get("last_nudge_turn") if st.get("last_nudge_turn") is not None else -999)
        cooldown = max(1, min(n, int(cfg.get("nudge_cooldown_turns") or 1)))
        return (since_probe >= n or (switched and st["turns"] > 0)) and since_nudge >= cooldown
    if switched:
        return (now() - float(st.get("last_nudge_ts") or 0)) >= 60
    last = max(last_probe_ts, float(st.get("last_nudge_ts") or 0), float(st.get("created_ts") or 0))
    return (now() - last) >= n * 60


def last_fresh_probe_ts(account_id: str | None = None) -> float | None:
    last = None
    for r in iter_jsonl(PROBES_INDEX):
        if r.get("mode") == "fresh" and (account_id is None or r.get("account_id") == account_id):
            ts = parse_iso(r.get("finished"))
            if ts:
                last = ts
    return last


def fresh_due(cfg: dict, account_id: str) -> bool:
    """Heartbeat for the fresh-session probe: purely time-based, independent of thread activity."""
    try:
        kind, n = parse_frequency(cfg.get("fresh_frequency") or "manual")
    except ValueError:
        return False
    if kind != "minutes" or fresh_running():
        return False
    last = last_fresh_probe_ts(account_id)
    return last is None or now() - last >= n * 60


def spawn_fresh_worker() -> bool:
    try:
        with open(WORKER_LOG, "a") as log:
            subprocess.Popen([sys.executable, DGC_BIN, "worker", "--fresh"], stdout=log, stderr=log, stdin=subprocess.DEVNULL,
                             start_new_session=True, env={k: v for k, v in os.environ.items() if not k.startswith("CODEX_SANDBOX")})
        return True
    except Exception as e:
        log_error(f"spawn_fresh_worker failed: {e}")
        return False


def tool_command_preview(payload: dict) -> str:
    ti = payload.get("tool_input")
    cmd = None
    if isinstance(ti, dict):
        for k in ("command", "cmd", "input", "code", "script"):
            if ti.get(k):
                cmd = ti[k]
                break
        if cmd is None:
            cmd = json.dumps(ti, ensure_ascii=False)
    elif ti is not None:
        cmd = ti
    if isinstance(cmd, list):
        cmd = " ".join(str(c) for c in cmd)
    return str(cmd or "")[:240]


def is_dgc_command(payload: dict) -> bool:
    cmd = tool_command_preview(payload)
    return "nerfed" in cmd or "is-gpt-nerfed" in cmd or "dgc" in cmd


def codex_bin(cfg: dict | None = None) -> str | None:
    cfg = cfg or load_config()
    if cfg.get("codex_bin") and os.path.exists(cfg["codex_bin"]):
        return cfg["codex_bin"]
    w = shutil.which("codex")
    if w:
        return w
    for p in APP_CODEX_BINS:
        if os.path.exists(p):
            return p
    return None


# --------------------------------------------------------------------------------------- the pet

LINES = {
    "MISMATCH_downgrade": [
        "🎉 Congrats! You've been nerfed! You asked for {expected}; the fingerprint says {top} ({p:.0%}, {n}/{q} answers). Enjoy the discount you didn't ask for.",
        "Great news: your {expected} session is answering like {top} ({p:.0%}). Nobody told you, but somebody saved money. Congrats!",
    ],
    "MISMATCH_upgrade": [
        "Congrats! You've been secretly upgraded: you asked for {expected}, the fingerprint says {top} ({p:.0%}). Don't tell anyone.",
    ],
    "MISMATCH_lateral": [
        "Congrats! You've been… re-routed. You asked for {expected}, the fingerprint says {top} ({p:.0%}). Same tier, different brain.",
    ],
    "DOWNGRADED_HARD": [
        "🎉 Congrats! You've been nerfed! Codex's own records say so: {detail}. No notice, no refund, no shame.",
    ],
    "DOWNGRADED_SERVER": [
        "🎉 Congrats! You've been nerfed! You asked for {expected}; the server's own response says {served} answered. No notice, no refund, no shame.",
    ],
    "UPGRADED": [
        "🎉 Congrats, and this time we mean it: you've been upgraded. Codex's own records say so: {detail}. Enjoy it while it lasts.",
    ],
    "MATCH": [
        "All clear: the fingerprint says {top} ({p:.0%}), which is what you asked for. The model you're paying for actually showed up. Cherish it.",
        "No downgrade detected: {top} at {p:.0%}. Suspiciously honest. I'll keep watching.",
    ],
    "SUSPICIOUS": [
        "Hmm. The fingerprint leans {top} ({p:.0%}) over your {expected} ({p_exp:.0%}), but not confidently enough to call it. I asked again and it is still murky. Watching.",
    ],
    "SUSPICIOUS_SERVER": [
        "Odd: the server's own response says {served} answered your {expected} request, while the fingerprint of the answers says {top} ({p:.0%}). Watching.",
    ],
    "SUSPICIOUS_SERVER_ONLY": [
        "Hmm. The server's own response says {served} answered your {expected} request, and the fingerprint could not check it. Watching.",
    ],
    "UNLISTED": [
        "{expected} isn't in the fingerprint bank yet, so I can only tell you who it looks like: {top} ({p:.0%}). Not a verdict.",
    ],
    "INVALID": [
        "Couldn't get a usable sample: {reason}. No verdict, no congratulations.",
    ],
    "SETTINGS_DOWNGRADE": [
        "Heads up: {detail}. If that wasn't you clicking, congrats — you've been downgraded!",
    ],
    "NUDGE": [
        "Probe due ({why}). Say  {cmd}  in this session, or  {side}  to keep it out of your context.",
    ],
}

FACES = {"MATCH": "•ᴗ•", "OK": "•ᴗ•", "MISMATCH": "ಠ_ಠ", "DOWNGRADED": "ಠ_ಠ", "SUSPICIOUS": "•_•", "UNLISTED": "•_•", "INVALID": "¬_¬", "NUDGE": "•o•"}


def pet_line(kind: str, seed: str = "", **fmt) -> str:
    rng = random.Random(seed or now())
    return rng.choice(LINES[kind]).format(**fmt)


def wrap(text: str, width: int) -> list[str]:
    words, out, cur = text.split(), [], ""
    for w in words:
        if cur and len(cur) + 1 + len(w) > width:
            out.append(cur)
            cur = w
        else:
            cur = f"{cur} {w}" if cur else w
    if cur:
        out.append(cur)
    return out


def pet_card(cfg: dict, verdict: str, quote: str, facts: list[str]) -> str:
    face = FACES.get(verdict.rstrip("!?"), FACES["OK"])
    art = ["   (\\__/)     ", f"   ({face})     ", "   / >🔍     "]
    wrapped = wrap(quote, 64)
    lines = [f"is-gpt-nerfed verdict: {verdict}", art[0],
             art[1] + (wrapped[0] if wrapped else ""), art[2] + (wrapped[1] if len(wrapped) > 1 else "")]
    lines.extend(" " * 14 + extra for extra in wrapped[2:])
    lines.append("")
    lines.extend("  " + f for f in facts)
    return "\n".join(lines)


def notify(cfg: dict, message: str, subtitle: str = "is-gpt-nerfed", title: str | None = None) -> None:
    if not cfg.get("notify", True) or sys.platform != "darwin":
        return
    title = title or "is-gpt-nerfed"

    def esc(s: str) -> str:
        return s.replace("\\", "\\\\").replace('"', '\\"')

    script = f'display notification "{esc(message[:230])}" with title "{esc(title)}" subtitle "{esc(subtitle)}"'
    try:
        subprocess.Popen(["osascript", "-e", script], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception as e:
        log_error(f"notify failed: {e}")


def play_sound(cfg: dict) -> None:
    if not cfg.get("sound", True) or sys.platform != "darwin" or not os.path.exists(CODEX_NOTIFICATION_WAV):
        return
    try:
        subprocess.Popen(["afplay", CODEX_NOTIFICATION_WAV], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass


# ---------------------------------------------------------------------------------- the probe


def probe_path(pid: str) -> str:
    return os.path.join(PROBES_DIR, safe_name(pid) + ".json")


MARGIN_SIGMA = 0.5


def assess(expected: str | None, analysis: dict | None, hard_evidence: list[dict], cfg: dict | None = None) -> dict:
    """Turn attribution probabilities into a verdict.

    Probabilities come from ModelTrace's calibrated softmax, which (as its author notes) amplifies small score
    gaps: a 100% can hide a thin margin. So a MISMATCH must be confident on three counts: p(top) ≥ confidence,
    p(declared) ≤ 1 − confidence, and the fused z-score margin between them ≥ 0.5σ. Anything weaker is
    SUSPICIOUS. A MISMATCH also needs at least two answers: one answer is calibrated at 95.5 %, too thin to call
    a downgrade on."""
    conf = float((cfg or {}).get("mismatch_confidence") or DEFAULT_CONFIG["mismatch_confidence"])
    out = {"verdict": None, "direction": None, "p_top": None, "p_expected": None, "margin": None, "confidence": None, "top": None}
    if hard_evidence:
        out.update(verdict="DOWNGRADED!", direction="hard")
        return out
    if not analysis:
        out["verdict"] = "INVALID"
        return out
    results = analysis.get("results") or []
    if not results:  # an analysis with no candidates is no verdict
        out["verdict"] = "INVALID"
        return out
    top = results[0]
    out.update(top=top["model"], p_top=top["probability"])
    exp = normalize_model(expected)
    if not exp:
        out["verdict"] = "UNKNOWN"
        return out
    exp_row = next((r for r in results if r["model"] == exp), None)
    if exp_row is None:
        out["verdict"] = "UNLISTED"
        return out
    out.update(p_expected=exp_row["probability"], margin=top["score"] - exp_row["score"])
    if top["model"] == exp:
        out.update(verdict="MATCH", confidence="high" if top["probability"] >= conf else "low")
        return out
    eps = 1e-9  # 0.80 ≥ 0.8 and 0.20 ≤ 1 − 0.8 must both hold despite binary floating point
    confident = (top["probability"] + eps >= conf and exp_row["probability"] <= (1 - conf) + eps
                 and out["margin"] + eps >= MARGIN_SIGMA)
    n_answers = analysis.get("used_outputs")
    if n_answers is not None and int(n_answers) < 2:
        confident = False
    out.update(verdict="MISMATCH" if confident else "SUSPICIOUS", direction=classify_change(exp, top["model"]),
               confidence="high" if confident else "low")
    return out


def fingerprint_verdict(expected: str | None, analysis: dict | None, hard_evidence: list[dict], cfg: dict | None = None) -> tuple[str, str | None]:
    a = assess(expected, analysis, hard_evidence, cfg)
    return a["verdict"], a["direction"]


def needs_confirmation(expected: str | None, outputs: list[dict], cfg: dict) -> bool:
    if not cfg.get("confirm_uncertain", False) or not outputs:
        return False
    try:
        analysis = core.analyze_global_outputs(outputs, load_bank())
    except ValueError:
        return False
    return assess(expected, analysis, [], cfg)["verdict"] == "SUSPICIOUS"


DATE_SUFFIX = re.compile(r"-(?:\d{4}-\d{2}-\d{2}|\d{8})$")


def served_slug(name) -> str:
    """A model name as the catalog spells it: lowercase, no provider prefix, no dated-snapshot suffix
    (gpt-6-astra-2026-08-20 is gpt-6-astra)."""
    return DATE_SUFFIX.sub("", normalize_model(name))


def served_model_check(model: str | None, effort: str | None, cfg: dict, originator: str | None = None) -> dict | None:
    """The server's own answer for the model and effort a probe is about to fingerprint (responses_meta). None when
    the check is switched off or there is no model to ask about; a failed check comes back with an "error"."""
    if not model or not cfg.get("served_check", True):
        return None
    try:
        return responses_meta.check_served_model(model, CODEX_HOME, effort=effort,
                                                 timeout_s=float(cfg.get("served_check_timeout_s") or 10),
                                                 originator=originator or "codex_cli_rs", client_version=VERSION)
    except Exception as e:
        log_event("served_check_error", level="warn", error=repr(e)[:200])
        return {"ok": False, "requested": model, "effort": effort, "served": None, "error": f"unexpected error: {e!r}"[:200]}


def server_finding(served: dict | None, cat: dict | None = None) -> dict | None:
    """What the server check says about the model it asked for:
      same          the requested model (a dated snapshot of it counts)
      downgrade     a model compare_models ranks below the requested one
      lateral       a known model the catalog does not rank, or ranks above only weakly
      upgrade       a known model ranked above it (high or medium confidence)
      unrecognized  a name neither Codex's catalog nor the fingerprint bank knows: reported, never counted
      failed        no answer
    None when the check did not run."""
    if not served:
        return None
    requested = served.get("requested")
    if not served.get("ok") or not served.get("served"):
        return {"state": "failed", "model": None, "requested": requested, "error": served.get("error") or "no answer"}
    name, exp = str(served["served"]), served_slug(requested)
    slug = served_slug(name)
    if not exp:
        return {"state": "unrecognized", "model": name, "requested": requested}
    if slug == exp:
        return {"state": "same", "model": name, "requested": requested}
    cat = load_catalog() if cat is None else cat
    known = {k.lower() for k in cat} | {m.lower() for m in core.bank_model_ids(load_bank())}
    if slug not in known:
        return {"state": "unrecognized", "model": name, "requested": requested}
    cmp = compare_models(exp, slug, cat)
    state = cmp["direction"]
    if state == "upgrade" and cmp["confidence"] == "low":
        state = "lateral"
    return {"state": state, "model": name, "requested": requested, "why": cmp["reason"]}


def combine_with_server(fp: dict, server: dict | None) -> dict:
    """The fingerprint's verdict, adjusted by what the server says. The server can raise a verdict, never clear one:
    a Match the server contradicts (it names a worse or a different model) becomes Suspicious, and a verdict the
    fingerprint could not reach (no answers, an unlisted model, a Suspicious lean) is decided by a downgrade the
    server admits to. An upgrade, an unrecognized name or a failed check changes nothing; they are reported next to
    the verdict."""
    a = dict(fp)
    state = (server or {}).get("state")
    if state not in ("downgrade", "lateral") or fp["verdict"] in ("MISMATCH", "DOWNGRADED!", "UNKNOWN"):
        return a
    if fp["verdict"] == "MATCH":  # the answers look like the requested model, the server names another
        a.update(verdict="SUSPICIOUS", direction="server", confidence="low")
    elif state == "downgrade":  # the fingerprint could not settle it; the server admits a downgrade
        a.update(verdict="DOWNGRADED!", direction="server", confidence="high")
    elif fp["verdict"] != "SUSPICIOUS":  # a lateral switch the fingerprint could not check
        a.update(verdict="SUSPICIOUS", direction="server", confidence="low")
    return a


def server_fact(server: dict) -> str:
    """The CLI card's line for the server check."""
    if server["state"] == "failed":
        return f"server check: no answer ({server.get('error')})"
    line = f"server says {server['model']}"
    if server["state"] == "same":
        return line + " (as asked)"
    if server["state"] == "unrecognized":
        return line + f" for {server.get('requested')}: a name Codex's catalog does not list, not counted"
    return line + f" for {server.get('requested')} ({server['state']}: {server.get('why')})"


def parent_hard_evidence(thread_id: str | None, rollout_hint: str | None = None) -> tuple[list[dict], list[dict]]:
    """Refresh the parent thread's passive scan and return (hard, soft) evidence."""
    if not thread_id:
        return [], []
    with locked_session(thread_id) as st:
        rp = st.get("transcript_path") or rollout_hint
        if not rp:
            row = db_thread(thread_id)
            rp = row.get("rollout_path") if row else None
        if rp and os.path.exists(rp):
            st["transcript_path"] = rp
            for e in scan_rollout(rp, st["scan"], hidden_models()):
                st["evidence"].append(e)
        active = active_evidence(st.get("evidence") or [])
        hard = [e for e in active if e.get("severity") == "hard"]
        soft = [e for e in active if e.get("severity") == "soft"]
    return hard, soft


def finalize_probe(rec: dict, outputs: list[dict], expected: str | None, errors: list[str], cfg: dict, quiet: bool = False) -> dict:
    bank = load_bank()
    analysis = None
    try:
        analysis = core.analyze_global_outputs(outputs, bank) if outputs else None
    except ValueError as e:
        errors = errors + [str(e)]
    if outputs and analysis is None and not errors:
        errors = errors + ["no usable answer"]
    hard, soft = parent_hard_evidence(rec.get("thread_id"), (rec.get("thread") or {}).get("path"))
    fp = assess(expected, analysis, hard, cfg)
    server = server_finding(rec.get("served"))
    if server:
        rec["server"] = server
    a = combine_with_server(fp, server)
    verdict, direction = a["verdict"], a["direction"]
    top = analysis["prediction"] if analysis else None
    p = analysis["probability"] if analysis else 0.0
    p_exp = a.get("p_expected") or 0.0
    n = analysis["used_outputs"] if analysis else 0
    q = int(rec.get("queries") or 1) * int(rec.get("rounds") or 1)
    fmt = {"expected": expected or "?", "top": top or "?", "p": p, "p_exp": p_exp, "n": n, "q": q,
           "served": (server or {}).get("model") or "?",
           "detail": hard[0]["detail"] if hard else "", "reason": "; ".join(errors)[:160] or "no answers"}
    if verdict == "DOWNGRADED!":
        quote = pet_line("DOWNGRADED_SERVER" if direction == "server" else "DOWNGRADED_HARD", seed=rec["id"], **fmt)
    elif verdict == "MISMATCH":
        quote = pet_line(f"MISMATCH_{direction}", seed=rec["id"], **fmt)
    elif verdict == "SUSPICIOUS":
        if direction == "server":
            quote = pet_line("SUSPICIOUS_SERVER" if analysis else "SUSPICIOUS_SERVER_ONLY", seed=rec["id"], **fmt)
        else:
            quote = pet_line("SUSPICIOUS", seed=rec["id"], **fmt)
    elif verdict in ("MATCH",):
        quote = pet_line("MATCH", seed=rec["id"], **fmt)
    elif verdict == "UNLISTED":
        quote = pet_line("UNLISTED", seed=rec["id"], **fmt)
    elif verdict == "UNKNOWN":
        quote = f"No expected model recorded for this session; the fingerprint says {top} ({p:.0%})."
    else:
        quote = pet_line("INVALID", seed=rec["id"], **fmt)

    rec.update({"status": "done" if (analysis or verdict != fp["verdict"]) else "failed", "finished": iso(), "expected": expected, "prediction": top,
                "probability": round(p, 4) if analysis else None, "p_expected": round(p_exp, 4) if analysis else None,
                "margin": round(a["margin"], 3) if a.get("margin") is not None else None, "confidence": a.get("confidence"),
                "used_outputs": n, "verdict": verdict, "direction": direction, "rounds": int(rec.get("rounds") or 1),
                "quote": quote, "errors": errors, "hard_evidence": hard[:5], "soft_evidence": soft[:5],
                "elapsed_s": rec.get("elapsed_s") or round(now() - float(rec.get("ts_start") or now()), 1)})
    if analysis:
        rec["results"] = [{k: (round(v, 4) if isinstance(v, float) else v) for k, v in r.items()} for r in analysis["results"][:6]]
        rec["family_probabilities"] = [{**f, "probability": round(f["probability"], 4)} for f in analysis["family_probabilities"]]
        rec["diagnostics"] = analysis["diagnostics"]
        rec["calibration"] = analysis["calibration"]
    write_json(probe_path(rec["id"]), rec)
    rec.setdefault("account", current_account())
    index_row = {k: rec.get(k) for k in ("id", "finished", "thread_id", "mode", "expected", "prediction", "probability", "p_expected",
                                         "margin", "confidence", "used_outputs", "queries", "rounds", "retries", "elapsed_s",
                                         "verdict", "direction", "status")}
    index_row["account_id"] = (rec.get("account") or {}).get("id")
    append_jsonl(PROBES_INDEX, index_row)
    log_event("probe_verdict", level="warn" if verdict in ("MISMATCH", "DOWNGRADED!", "SUSPICIOUS") else ("error" if verdict == "INVALID" else "info"),
              probe=rec["id"], mode=rec.get("mode"), sid=rec.get("thread_id"), verdict=verdict, direction=direction,
              expected=expected, prediction=top, probability=rec.get("probability"), p_expected=rec.get("p_expected"),
              margin=rec.get("margin"), confidence=rec.get("confidence"), used_outputs=n, queries=rec.get("queries"),
              rounds=rec.get("rounds"), retries=rec.get("retries"), waited_for_turn=rec.get("waited_for_turn"),
              elapsed_s=rec.get("elapsed_s"), account=(rec.get("account") or {}).get("id"),
              server=(server or {}).get("model"), server_state=(server or {}).get("state"),
              top=[{"model": r["model"], "p": r.get("probability"), "score": r.get("score")} for r in (rec.get("results") or [])[:3]],
              hard_evidence=[e.get("detail") for e in hard[:3]], soft_evidence=[e.get("detail") for e in soft[:2]],
              errors=errors[:3] or None)
    facts = [f"probe {rec['id']}  ·  session {rec.get('thread_id') or '?'}  ·  mode {rec.get('mode')}  ·  {n}/{q} answers used"
             + (f" in {rec['rounds']} rounds" if rec.get("rounds", 1) > 1 else "") + (f"  ·  retried ×{rec['retries']}" if rec.get("retries") else "")
             + f"  ·  {rec['elapsed_s']}s",
             f"expected {expected or '?'}" + (f" {p_exp:.0%}" if analysis and a.get("p_expected") is not None else "")
             + f"  ·  fingerprint {top or '?'}" + (f" {p:.0%}" if analysis else "")
             + (f"  ·  margin {a['margin']:+.2f}σ" if a.get("margin") is not None else "")
             + (f"  ·  direction: {direction}" if direction and verdict in ("MISMATCH", "SUSPICIOUS") else "")]
    if analysis:
        facts.append("top candidates: " + ", ".join(f"{r['model']} {r['probability']:.0%}" for r in analysis["results"][:3])
                     + f"  ·  calibration n={analysis['calibration']['queries']} (cv {analysis['calibration']['cv_accuracy']:.1%})")
    if server:
        facts.append(server_fact(server))
    for e in hard[:3]:
        facts.append("hard evidence: " + e["detail"])
    for e in soft[:2]:
        facts.append("needs your confirmation: " + e["detail"])
    for err in errors[:3]:
        facts.append("problem: " + err)
    facts.append(f"details: {DGC_BIN} explain {rec['id']}   ·   method: {DGC_BIN} explain --method")
    card = pet_card(cfg, verdict, quote, facts)
    if not quiet:
        print(card)

    # thread-side delivery, notifications, optional halt
    alert_thread = verdict in ("MISMATCH", "DOWNGRADED!") or (verdict == "MATCH" and cfg.get("announce_ok")) or verdict == "UNLISTED"
    tid = rec.get("thread_id")
    if tid:
        with locked_session(tid) as st:
            st["last_probe_ts"] = now()
            st["last_probe_turn"] = int(st.get("turns") or 0)
            st["last_probe_account"] = (rec.get("account") or {}).get("id")
            st["probe_running"] = None
            st["requested"] = False
            st.setdefault("probes", []).append(rec["id"])
            st["probes"] = st["probes"][-50:]
            if alert_thread:
                st.setdefault("alerts", []).append({"ts": iso(), "probe": rec["id"], "verdict": verdict, "text": quote, "delivered": False})
                st["alerts"] = st["alerts"][-20:]
            if cfg.get("halt_on_mismatch") and verdict in ("MISMATCH", "DOWNGRADED!"):
                st["halt"] = {"id": rec["id"], "ts": iso(), "detail": quote}
                log_event("halt_set", level="warn", sid=tid, probe=rec["id"], verdict=verdict)
    if verdict in ("MISMATCH", "DOWNGRADED!", "SUSPICIOUS", "UNLISTED") or (verdict == "MATCH" and cfg.get("notify_on_ok")):  # a failed attempt is logged, not announced
        notify(cfg, quote, subtitle=f"verdict: {verdict}")
    if verdict == "DOWNGRADED!" or (verdict == "MISMATCH" and direction == "downgrade"):
        play_sound(cfg)
    return rec


def default_originator(codex_bin: str | None) -> str:
    """What the user's own client reports as its originator: the desktop app when its bundled binary is used."""
    return "Codex Desktop" if codex_bin and ".app/Contents/" in codex_bin else "codex_cli_rs"


def resolve_originator(cfg: dict, codex_bin: str | None, thread_row: dict | None = None, override: str | None = None) -> str:
    """The originator a probe runs under: an explicit override, then the config, then the probed session's own,
    then the client that owns the codex binary."""
    if override:
        return override
    configured = str(cfg.get("probe_originator") or "auto")
    if configured != "auto":
        return configured
    return (thread_row or {}).get("originator") or default_originator(codex_bin)


def ask_server(rec: dict, model: str | None, effort: str | None, cfg: dict, originator: str) -> None:
    """The server check of a probe (served_check): one small request before the forks, recorded on the probe.
    It never replaces them; finalize_probe weighs the two."""
    served = served_model_check(model, effort, cfg, originator=originator)
    if served is None:
        return
    rec["served"] = served
    write_json(probe_path(rec["id"]), rec)
    log_event("served_check", level="info" if served.get("ok") else "warn", probe=rec["id"], sid=rec.get("thread_id"),
              mode=rec.get("mode"), requested=model, effort=effort, served=served.get("served"),
              elapsed_s=served.get("elapsed_s"), error=served.get("error"))


def run_fork_probe(thread_id: str, cfg: dict, queries: int | None = None, quiet: bool = False, originator: str | None = None) -> dict:
    ensure_dirs()
    cb = codex_bin(cfg)
    if not cb:
        raise SystemExit("codex binary not found; set `nerfed config set codex_bin /path/to/codex`")
    q = max(1, min(3, int(queries or cfg.get("queries") or 3)))
    acct = note_account("probe")
    rec = {"id": cas.new_probe_id(), "mode": "fork", "thread_id": thread_id, "started": iso(), "ts_start": now(),
           "queries": q, "status": "running", "dgc_version": VERSION, "pid": os.getpid(),
           "account": {k: acct.get(k) for k in ("id", "label", "plan")}}
    write_json(probe_path(rec["id"]), rec)
    with locked_session(thread_id) as st:
        st["probe_running"] = {"pid": os.getpid(), "ts": now(), "probe": rec["id"]}
    log_event("probe_start", probe=rec["id"], mode="fork", sid=thread_id, queries=q, account=acct["id"],
              parallel=bool(cfg.get("parallel", True)), languages=cfg.get("languages"))

    def on_wait(reason: str) -> None:
        rec["waited_for_turn"] = True
        log_event("probe_wait", probe=rec["id"], sid=thread_id, reason=reason[:200])
        with locked_session(thread_id) as st:
            if st.get("probe_running"):
                st["probe_running"]["note"] = "waiting for the current turn to finish"

    row = db_thread(thread_id)
    orig = resolve_originator(cfg, cb, row, originator)
    rec["originator"] = orig
    write_json(probe_path(rec["id"]), rec)
    log_event("probe_originator", probe=rec["id"], sid=thread_id, originator=orig)
    ask_server(rec, (row or {}).get("model"), (row or {}).get("reasoning_effort"), cfg, orig)

    def runner(n: int = q):
        return cas.probe_thread(cb, thread_id, queries=n, languages=cfg.get("languages") or ["zh", "en"],
                                timeout_s=float(cfg.get("probe_timeout_s") or 300), parallel=bool(cfg.get("parallel", True)),
                                busy_wait_s=float(cfg.get("busy_wait_s") or 600), on_wait=on_wait, originator=orig)

    expected = row.get("model") if row else None
    outputs, errors, out = probe_round(runner, rec)
    if out:
        rec["thread"], rec["forks"], rec["elapsed_s"] = out["thread"], out["forks"], out["elapsed_s"]
        expected = out["thread"].get("model") or expected
        outputs, errors = top_up_timeouts(rec, outputs, errors, q, runner, sid=thread_id, mode="fork")
    if needs_confirmation(expected, outputs, cfg):  # SUSPICIOUS first round: one more round before the verdict is final
        rec["rounds"] = 2
        log_event("probe_confirm_round", probe=rec["id"], sid=thread_id, reason="first round SUSPICIOUS")
        o2, e2, out2 = probe_round(runner, rec)
        outputs, errors = outputs + o2, errors + e2
        if out2:
            rec["forks"] = (rec.get("forks") or []) + out2["forks"]
            rec["elapsed_s"] = round(float(rec.get("elapsed_s") or 0) + out2["elapsed_s"], 1)
    return finalize_probe(rec, outputs, expected, errors, cfg, quiet=quiet)


def fork_summary(f: dict) -> dict:
    text = f.get("text") or ""
    return {"id": f.get("id"), "model": f.get("model"), "effort": f.get("effort"), "tier": f.get("service_tier"),
            "language": f.get("language"), "count": f.get("count"), "chars": len(text), "error": (f.get("error") or None),
            "elapsed_s": f.get("elapsed_s"), "usage": f.get("usage"), "rate_limits": f.get("rate_limits")}


def probe_round(runner, rec: dict) -> tuple[list[dict], list[str], dict | None]:
    """Run one round of forks; a single transport/network failure is retried once automatically."""
    attempt = 0
    while True:
        attempt += 1
        try:
            out = runner()
        except cas.ThreadBusy as e:
            log_event("probe_busy", level="warn", probe=rec["id"], sid=rec.get("thread_id"), error=str(e)[:300])
            return [], [f"thread stayed busy: {e}"], None
        except cas.AppServerError as e:
            if attempt < 2 and transport_like([str(e)]):
                rec["retries"] = int(rec.get("retries") or 0) + 1
                log_event("probe_retry", level="warn", probe=rec["id"], sid=rec.get("thread_id"), attempt=attempt, error=str(e)[:300])
                time.sleep(8)
                continue
            log_event("probe_transport_error", level="error", probe=rec["id"], sid=rec.get("thread_id"), error=str(e)[:300])
            return [], [str(e)], None
        except Exception as e:  # never leave the session locked
            log_error(f"probe {rec['id']} crashed: {e!r}")
            return [], [f"unexpected error: {e!r}"], None
        outputs = [{"text": f["text"], "expected_count": f["count"]} for f in out["forks"] if f.get("text") and not f.get("error")]
        errors = [f["error"] for f in out["forks"] if f.get("error")]
        rec["rate_limits"] = out.get("rate_limits")
        log_event("probe_round", probe=rec["id"], sid=rec.get("thread_id"), attempt=attempt, answers=len(outputs),
                  fork_errors=len(errors), elapsed_s=out.get("elapsed_s"), last_turn=(out.get("thread") or {}).get("last_turn"),
                  last_turn_status=(out.get("thread") or {}).get("last_turn_status"), rate_limits=out.get("rate_limits"),
                  forks=[fork_summary(f) for f in out.get("forks") or []])
        if not outputs and attempt < 2 and errors and transport_like(errors):
            rec["retries"] = int(rec.get("retries") or 0) + 1
            log_event("probe_retry", level="warn", probe=rec["id"], sid=rec.get("thread_id"), attempt=attempt, error=errors[0][:300])
            time.sleep(8)
            continue
        return outputs, errors, out


def top_up_timeouts(rec: dict, outputs: list[dict], errors: list[str], wanted: int, runner_n, sid: str | None = None,
                    mode: str | None = None) -> tuple[list[dict], list[str]]:
    """A fork that did not answer within the deadline is replaced once, so that a slow model does not drop out of
    the sample and leave the verdict to whichever model answered fast."""
    missing = int(wanted) - len(outputs)
    timed_out = [e for e in errors if "timed out" in e or "deadline" in e]
    if missing <= 0 or not timed_out or rec.get("topped_up"):
        return outputs, errors
    rec["topped_up"] = missing
    rec["retries"] = int(rec.get("retries") or 0) + 1
    log_event("probe_top_up", level="warn", probe=rec["id"], sid=sid, mode=mode, missing=missing, reason=timed_out[0][:160])
    o2, e2, out2 = probe_round(lambda: runner_n(missing), rec)
    if out2:
        rec["forks"] = (rec.get("forks") or []) + out2["forks"]
        rec["elapsed_s"] = round(float(rec.get("elapsed_s") or 0) + out2["elapsed_s"], 1)
    return outputs + o2, errors + e2


FRESH_RUNNING = "fresh_running.json"


def fresh_running() -> dict | None:
    r = read_json(os.path.join(NERFED_HOME, FRESH_RUNNING))
    if r and pid_alive(r.get("pid")):
        return r
    return None


def default_model_settings() -> tuple[str | None, str | None]:
    """What a brand-new Codex session would use: config.toml first, then the most recent main thread."""
    model, effort = config_toml_model()
    if not model:
        rows = db_recent_main_threads(1)
        if rows:
            model, effort = rows[0].get("model"), rows[0].get("reasoning_effort")
    return model, effort


def run_fresh_probe(cfg: dict, model: str | None = None, effort: str | None = None, queries: int | None = None, quiet: bool = False,
                    originator: str | None = None) -> dict:
    """Global probe: brand-new ephemeral sessions, no history. Answers 'what does a new session get right now?'."""
    ensure_dirs()
    cb = codex_bin(cfg)
    if not cb:
        raise SystemExit("codex binary not found; set `nerfed config set codex_bin /path/to/codex`")
    dm, de = default_model_settings()
    model, effort = model or dm, effort or de
    if not model:
        raise SystemExit("no default model found; pass --model")
    q = max(1, min(3, int(queries or cfg.get("queries") or 3)))
    acct = note_account("probe")
    rec = {"id": cas.new_probe_id(), "mode": "fresh", "thread_id": None, "started": iso(), "ts_start": now(), "queries": q,
           "status": "running", "dgc_version": VERSION, "pid": os.getpid(), "requested_model": model, "requested_effort": effort,
           "account": {k: acct.get(k) for k in ("id", "label", "plan")}}
    write_json(probe_path(rec["id"]), rec)
    write_json(os.path.join(NERFED_HOME, FRESH_RUNNING), {"pid": os.getpid(), "ts": now(), "probe": rec["id"]})
    log_event("probe_start", probe=rec["id"], mode="fresh", model=model, effort=effort, queries=q, account=acct["id"])
    expected = model

    orig = resolve_originator(cfg, cb, None, originator)
    rec["originator"] = orig
    write_json(probe_path(rec["id"]), rec)
    log_event("probe_originator", probe=rec["id"], mode="fresh", originator=orig)

    ask_server(rec, model, effort, cfg, orig)

    def runner(n: int = q):
        return cas.probe_fresh(cb, model, effort=effort, queries=n, languages=cfg.get("languages") or ["zh", "en"],
                               timeout_s=float(cfg.get("probe_timeout_s") or 300), parallel=bool(cfg.get("parallel", True)),
                               originator=orig)

    try:
        outputs, errors, out = probe_round(runner, rec)
        if out:
            rec["thread"], rec["forks"], rec["elapsed_s"] = out["thread"], out["forks"], out["elapsed_s"]
            expected = out["thread"].get("model") or model
            outputs, errors = top_up_timeouts(rec, outputs, errors, q, runner, mode="fresh")
        if needs_confirmation(expected, outputs, cfg):
            rec["rounds"] = 2
            log_event("probe_confirm_round", probe=rec["id"], mode="fresh", reason="first round SUSPICIOUS")
            o2, e2, out2 = probe_round(runner, rec)
            outputs, errors = outputs + o2, errors + e2
            if out2:
                rec["forks"] = (rec.get("forks") or []) + out2["forks"]
                rec["elapsed_s"] = round(float(rec.get("elapsed_s") or 0) + out2["elapsed_s"], 1)
    finally:
        try:
            os.remove(os.path.join(NERFED_HOME, FRESH_RUNNING))
        except OSError:
            pass
    return finalize_probe(rec, outputs, expected, errors, cfg, quiet=quiet)


TRANSPORT_PATTERNS = ("stayed busy", "in-progress turn", "timed out", "exited", "transport", "app-server", "deadline", "inference failed", "connection",
                      "network", "unexpected error", "no usable answer",
                      "thread-store", "behind durable rollout", "projection")  # Codex's store lagging its rollout: transient


def transport_like(errors: list[str]) -> bool:
    """True when every error looks like a network / transport / capacity failure rather than a verdict."""
    if not errors:
        return False
    return all(any(pat in str(e).lower() for pat in TRANSPORT_PATTERNS) for e in errors)


def spawn_worker(thread_id: str, cfg: dict) -> bool:
    try:
        with open(WORKER_LOG, "a") as log:
            subprocess.Popen([sys.executable, DGC_BIN, "worker", "--thread", thread_id], stdout=log, stderr=log,
                             stdin=subprocess.DEVNULL, start_new_session=True,
                             env={k: v for k, v in os.environ.items() if not k.startswith("CODEX_SANDBOX")})
        return True
    except Exception as e:
        log_error(f"spawn_worker failed: {e}")
        return False


def run_schedule(st: dict, cfg: dict, acct: dict, messages: list, via: str = "hook") -> bool:
    """The probe schedule for one main session (call it under the session's lock): launch a worker in mode auto,
    or queue a nudge in mode nudge. The Stop hook runs it after every turn; `tick` runs it for threads that are due
    but quiet. Returns True when a worker was launched."""
    sid = st["sid"]
    running = st.get("probe_running")
    if running and not pid_alive(running.get("pid")):
        st["probe_running"] = running = None
    if st.get("kind") != "main" or running or not (st.get("requested") or probe_due(st, cfg, acct["id"])):
        return False
    try:
        kind, n = parse_frequency(cfg.get("frequency"))
    except ValueError:
        kind, n = "manual", 0
    switched = stale_for_account(st.get("last_probe_account"), acct["id"]) and st.get("probes")
    why = ("requested" if st.get("requested") else "account changed since the last probe" if switched
           else f"{st['turns'] - int(st.get('last_probe_turn') or 0)} turns since the last probe" if kind == "turns"
           else f"{n} min elapsed")
    log_event("probe_due", sid=sid, why=why, mode=cfg.get("mode"), turns=st["turns"], account=acct["id"], via=via)
    if cfg.get("mode") == "auto":
        if not spawn_worker(sid, cfg):
            return False
        st["probe_running"] = {"pid": None, "ts": now(), "probe": "spawning"}
        st["last_probe_turn"], st["last_probe_ts"], st["requested"] = st["turns"], now(), False
        log_event("worker_spawn", sid=sid, why=why, via=via)
        return True
    if via != "hook":  # a nudge is a message inside the thread, which only a hook can deliver
        return False
    st["last_nudge_turn"], st["last_nudge_ts"] = st["turns"], now()
    messages.append(pet_line("NUDGE", why=why, cmd=SKILL_CMD, side=SIDE_CMD))
    log_event("nudge", sid=sid, why=why)
    return False


# ---- self-answer mode (inside an ephemeral /side conversation) ----------------------------------


def challenge_text(rec: dict, index: int) -> str:
    fork = rec["forks"][index]
    k, q = index + 1, int(rec.get("queries") or 1)
    return "\n".join([
        f"DGC PROBE {rec['id']} · challenge {k}/{q} (self-answer mode: this is an ephemeral side conversation)",
        cas.fork_prompt(fork["language"], fork["count"]),
        "Write the integers literally into this command (no code, RNG, files, earlier samples or other models):",
        f"  {DGC_BIN} probe submit-numbers {rec['id']} --numbers '[YOUR_LITERAL_INTEGERS]'",
        "" if k < q else "This is the last challenge; the verdict card prints after this submission.",
    ])


def start_self_probe(parent_id: str | None, side_id: str | None, cfg: dict, expected: str | None) -> int:
    ensure_dirs()
    q = max(1, min(3, int(cfg.get("queries") or 3)))
    rng = random.Random()
    rec = {"id": cas.new_probe_id(), "mode": "self", "thread_id": parent_id, "side_thread_id": side_id, "started": iso(),
           "ts_start": now(), "queries": q, "status": "open", "expected": expected, "answers": [], "dgc_version": VERSION,
           "account": current_account(),
           "forks": [{"language": rng.choice(cfg.get("languages") or ["zh", "en"]), "count": rng.randint(*cas.COUNT_RANGE)} for _ in range(q)]}
    write_json(probe_path(rec["id"]), rec)
    print(challenge_text(rec, 0))
    return 0


def cmd_probe_submit_numbers(args) -> int:
    cfg = load_config()
    rec = read_json(probe_path(args.probe_id))
    if not rec or rec.get("mode") != "self":
        raise SystemExit("unknown self-answer probe id")
    if rec.get("status") != "open":
        raise SystemExit(f"probe {rec['id']} is already {rec['status']}")
    text = args.numbers
    if getattr(args, "numbers_file", None):
        with open(args.numbers_file, "r", encoding="utf-8") as f:
            text = f.read()
    if not text and not sys.stdin.isatty():
        text = sys.stdin.read()
    numbers = core.parse_numbers(text or "")
    idx = len(rec["answers"])
    fork = rec["forks"][idx]
    minimum = core.minimum_numbers(fork["count"])
    rec["answers"].append({"text": text or "", "expected_count": fork["count"], "parsed": len(numbers), "accepted": len(numbers) >= minimum, "ts": iso()})
    if len(numbers) < minimum:
        print(f"only {len(numbers)} valid integers parsed (need ≥ {minimum}); this answer will not count.")
    write_json(probe_path(rec["id"]), rec)
    if len(rec["answers"]) < int(rec["queries"]) and not args.final:
        print(challenge_text(rec, len(rec["answers"])))
        return 0
    outputs = [{"text": a["text"], "expected_count": a["expected_count"]} for a in rec["answers"] if a["accepted"]]
    errors = [f"answer {i + 1}: only {a['parsed']} valid integers" for i, a in enumerate(rec["answers"]) if not a["accepted"]]
    rec["elapsed_s"] = round(now() - float(rec.get("ts_start") or now()), 1)
    finalize_probe(rec, outputs, rec.get("expected"), errors, cfg)
    return 0


# ---- entry points -------------------------------------------------------------------------------


def resolve_thread(thread_arg: str | None) -> tuple[str | None, str]:
    if thread_arg:
        return thread_arg, "explicit"
    for var in ("CODEX_THREAD_ID", "CODEX_SESSION_ID"):
        if os.environ.get(var):
            return os.environ[var], var
    cwd = os.getcwd()
    cutoff = now() - 30 * 60
    for e in reversed(tail_jsonl(EVENTS_PATH, 400)):
        try:
            ts = dt.datetime.strptime(e["ts"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc).timestamp()
        except Exception:
            continue
        if ts < cutoff:
            break
        if e.get("event") in ("UserPromptSubmit", "Stop", "SessionStart") and e.get("cwd") == cwd:
            return e.get("sid"), "recent-hook-event"
    row = db_recent_main_thread(cwd)
    return (row["id"], "recent-main-thread") if row else (None, "none")


def expected_model_for(thread_id: str | None) -> str | None:
    if thread_id:
        row = db_thread(thread_id)
        if row and row.get("model"):
            return row["model"]
        st = read_json(session_path(thread_id))
        if st and st.get("model"):
            return st["model"]
    return config_toml_model()[0]


def display_width(s: str) -> int:
    import unicodedata
    return sum(2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1 for ch in s)


def fit(s, width: int) -> str:
    """Pad or truncate to a display width (CJK-aware) so menu columns line up."""
    s = str(s or "")
    if display_width(s) <= width:
        return s + " " * (width - display_width(s))
    out, w = "", 0
    for ch in s:
        cw = display_width(ch)
        if w + cw > width - 1:
            break
        out += ch
        w += cw
    return out + "…" + " " * max(0, width - w - 1)


def pick_probe_target(cfg: dict):
    """Interactive picker (vendored simple-term-menu). Returns ("fresh", None), ("thread", id) or None on escape."""
    sys.path.insert(0, os.path.join(HERE, "vendor"))
    try:
        from simple_term_menu import TerminalMenu
    except Exception as e:  # unsupported terminal / platform
        raise SystemExit(f"interactive picker unavailable ({e}); pass --thread <id>")
    snap = build_snapshot(cfg)
    entries, targets = [], []
    gp = snap.get("global_probe")
    model = (snap.get("default_model") or "?") + (f" @ {snap['default_effort']}" if snap.get("default_effort") else "")
    entries.append(f"{fit('Fresh session · brand-new ephemeral sessions', 44)} {fit(model, 22)} {fit('', 16)} "
                   + (f"{gp['verdict']} {gp.get('finished_ago') or ''}" if gp else "never probed"))
    targets.append(("fresh", None))
    for t in snap["threads"]:
        lp = t.get("last_probe")
        verdict = "probing…" if t.get("probe_running") else (f"{lp['verdict']} {lp.get('finished_ago') or ''}" if lp else "no probe yet")
        model = (t.get("model") or "?") + (f" @ {t['effort']}" if t.get("effort") else "")
        entries.append(f"{fit(t['title'], 44)} {fit(model, 22)} {fit('active ' + (t.get('updated_ago') or ''), 16)} {verdict}")
        targets.append(("thread", t["id"]))
    title = ("is-gpt-nerfed · probe which session?   ↑↓ move   / search   enter probe   esc quit\n"
             f"{fit('session', 44)} {fit('model', 22)} {fit('activity', 16)} last verdict")
    try:
        menu = TerminalMenu(entries, title=title, cycle_cursor=True, clear_screen=False, search_key="/", show_search_hint=True,
                            menu_cursor="▸ ", menu_cursor_style=("fg_red", "bold"), menu_highlight_style=("standout",))
        idx = menu.show()
    except NotImplementedError as e:  # e.g. TERM not set
        raise SystemExit(f"interactive picker needs a terminal ({e}); pass --thread <id> or --no-pick")
    return None if idx is None else targets[idx]


def cmd_probe_now(args) -> int:
    cfg = load_config()
    ensure_dirs()
    interactive = (not args.thread and not getattr(args, "no_pick", False)
                   and not any(os.environ.get(v) for v in ("CODEX_THREAD_ID", "CODEX_SESSION_ID"))
                   and sys.stdin.isatty() and sys.stdout.isatty())
    if interactive:
        choice = pick_probe_target(cfg)
        if choice is None:
            print("cancelled")
            return 0
        if choice[0] == "fresh":
            return cmd_probe_fresh(argparse.Namespace(model=None, effort=None, queries=args.queries))
        tid, how = choice[1], "picker"
    else:
        tid, how = resolve_thread(args.thread)
    if not tid:
        raise SystemExit("cannot determine the session: pass --thread <id> (Codex exports CODEX_THREAD_ID to tool commands)")
    mode = args.mode
    if mode == "auto":
        mode = "fork" if thread_is_persisted(tid) else "self"
    if mode == "self":
        side_id = tid if not thread_is_persisted(tid) else None
        parent = tid if thread_is_persisted(tid) else None
        if parent is None:
            st = load_session(tid)
            parent = st.get("parent_thread_id")
            if not parent:
                row = db_recent_main_thread(os.getcwd(), exclude=tid)
                parent = row["id"] if row else None
        return start_self_probe(parent, side_id, cfg, expected_model_for(parent or tid))
    log_event("probe_requested", sid=tid, via=how, mode=mode, sandboxed=os.environ.get("CODEX_SANDBOX_NETWORK_DISABLED") == "1")
    if os.environ.get("CODEX_SANDBOX_NETWORK_DISABLED") == "1" and not args.force:
        with locked_session(tid) as st:
            st["requested"] = True
        print(f"Queued (session {tid}, via {how}): this shell runs inside Codex's network-less sandbox, so the probe will start "
              "in the background the moment this turn ends. The verdict pops up as a notification; it is also shown at the "
              f"start of the next turn and in `{DGC_BIN} report`.")
        return 0
    run_fork_probe(tid, cfg, queries=args.queries, quiet=False, originator=getattr(args, "originator", None))
    return 0


def cmd_worker(args) -> int:
    cfg = load_config()
    if getattr(args, "fresh", False) or not args.thread:
        if fresh_running():
            print(f"{iso()} fresh probe already running; skipping")
            return 0
        try:
            rec = run_fresh_probe(cfg, model=args.model, effort=args.effort, queries=args.queries, quiet=True)
            print(f"{iso()} fresh probe {rec['id']} verdict {rec.get('verdict')} ({rec.get('expected')} vs {rec.get('prediction')})")
        except SystemExit as e:
            print(f"{iso()} fresh worker aborted: {e}")
        return 0
    try:
        rec = run_fork_probe(args.thread, cfg, queries=args.queries, quiet=True)
        print(f"{iso()} probe {rec['id']} session {args.thread} verdict {rec.get('verdict')} ({rec.get('expected')} vs {rec.get('prediction')})")
    except SystemExit as e:
        print(f"{iso()} worker aborted: {e}")
    finally:
        with locked_session(args.thread) as st:
            st["probe_running"] = None
    return 0


def cmd_tick(args) -> int:
    """The app's scheduler heartbeat. The Stop hook runs the probe schedule after every turn, so a thread whose
    due time passes while it is quiet would wait for a Stop event that may never come (a session finished at
    minute 29 is never probed). The app calls this whenever the snapshot shows a thread that is due and active."""
    cfg = load_config()
    if cfg.get("mode") != "auto":
        print(f"{iso()} tick: mode is {cfg.get('mode')}; probes are offered inside the thread, nothing to launch")
        return 0
    ensure_dirs()
    acct = note_account("tick")
    launched, skipped = [], 0
    for st in all_sessions():
        if st.get("kind") != "main" or st.get("ended") or st.get("halt"):
            continue
        if now() - (parse_iso(st.get("updated")) or 0) >= ACTIVE_WINDOW_S:  # quiet for a while: whoever was here has left
            continue
        if not (st.get("requested") or probe_due(st, cfg, acct["id"])) or not interactive_thread(db_thread(st["sid"])):
            continue
        with locked_session(st["sid"]) as live:  # decide again under the lock: a hook may have run the schedule meanwhile
            if run_schedule(live, cfg, acct, [], via="tick"):
                launched.append(live["sid"])
            else:
                skipped += 1
    what = ("launched a probe for " + ", ".join(launched)) if launched else "nothing due"
    print(f"{iso()} tick: {what}" + (f" · {skipped} already running or no longer due" if skipped else ""))
    return 0


def cmd_probe_fresh(args) -> int:
    cfg = load_config()
    if fresh_running():
        raise SystemExit("a fresh-session probe is already running")
    run_fresh_probe(cfg, model=args.model, effort=args.effort, queries=args.queries, quiet=False, originator=getattr(args, "originator", None))
    return 0


def cmd_served(args) -> int:
    """The server check on its own: which model the server says answers a request for this model right now.
    Exit 0: the model asked for; 2: another model; 1: no answer."""
    cfg = load_config()
    model, effort = args.model, args.effort
    if not model:
        dm, de = default_model_settings()
        model, effort = dm, effort or de
    if not model:
        raise SystemExit("no default model found; pass --model")
    orig = resolve_originator(cfg, codex_bin(cfg), None, args.originator)
    r = responses_meta.check_served_model(model, CODEX_HOME, effort=effort, timeout_s=float(cfg.get("served_check_timeout_s") or 10),
                                          originator=orig, client_version=VERSION)
    f = server_finding(r)
    print(f"asked for:   {model}" + (f" @ {effort}" if effort else "") + f"  (as {orig})")
    if f["state"] == "failed":
        print(f"no answer:   {f['error']}")
        return 1
    what = {"same": "the model asked for", "downgrade": "a downgrade", "upgrade": "an upgrade",
            "lateral": "a different model the catalog does not rank", "unrecognized": "a name Codex's catalog does not list"}[f["state"]]
    print(f"server says: {f['model']}  ({what}" + (f": {f['why']}" if f.get("why") else "") + ")")
    if r.get("header_model") and r.get("body_model") and served_slug(r["header_model"]) != served_slug(r["body_model"]):
        print(f"             OpenAI-Model header {r['header_model']}, response.model {r['body_model']}")
    print(f"             {r.get('elapsed_s')} s" + (f"  ·  request {r['request_id']}" if r.get("request_id") else ""))
    print("This is what the server says. Only a probe's fingerprint checks which model actually answered.")
    return 0 if f["state"] == "same" else 2


# ---------------------------------------------------------------------------------------- hooks


def deliver_alerts(st: dict, out: dict, model_visible: bool, cfg: dict) -> None:
    pending = [a for a in st.get("alerts") or [] if not a.get("delivered")]
    if not pending:
        return
    text = "\n".join(a["text"] for a in pending)
    prefix = "is-gpt-nerfed: "
    out["systemMessage"] = (out.get("systemMessage", "") + "\n" if out.get("systemMessage") else "") + prefix + text
    if model_visible:
        ctx = ("[is-gpt-nerfed] A model-integrity probe of this session finished. Before anything else, tell the user "
               f"verbatim: {text}")
        hso = out.setdefault("hookSpecificOutput", {})
        hso["additionalContext"] = (hso.get("additionalContext", "") + "\n" if hso.get("additionalContext") else "") + ctx
        for a in pending:
            a["delivered"] = True
        log_event("alert_delivered", sid=st.get("sid"), probes=[a.get("probe") for a in pending], verdicts=[a.get("verdict") for a in pending])


def cmd_hook(args) -> int:
    raw = ""
    try:
        if not sys.stdin.isatty():
            raw = sys.stdin.read()
    except Exception:
        raw = ""
    try:
        payload = json.loads(raw) if raw.strip() else {}
        if not isinstance(payload, dict):
            payload = {"_raw": payload}
    except Exception:
        payload = {"_unparsed": raw[:2000]}
    ev = payload.get("hook_event_name") or payload.get("hookEventName") or args.event or "unknown"
    sid = str(payload.get("session_id") or payload.get("thread_id") or payload.get("threadId") or "unknown")
    if os.environ.get("NERFED_PROBE_PROCESS"):  # hooks fired by our own probe app-server: ignore
        return 0
    cfg = load_config()
    ensure_dirs()
    acct = note_account("hook")
    log = {"ts": iso(), "event": ev, "sid": sid, "cwd": payload.get("cwd"), "model": payload.get("model"),
           "turn_id": payload.get("turn_id"), "transcript_path": payload.get("transcript_path"), "keys": sorted(payload.keys()),
           "plugin_root_env": os.environ.get("PLUGIN_ROOT")}
    if ev == "UserPromptSubmit":
        log["prompt_chars"] = len(str(payload.get("prompt") or ""))
    if ev in ("PreToolUse", "PostToolUse"):
        log["tool_name"], log["command"] = payload.get("tool_name"), tool_command_preview(payload)
    append_jsonl(EVENTS_PATH, log)

    out: dict = {}
    with locked_session(sid) as st:
        st["hook_events"] = int(st.get("hook_events") or 0) + 1
        if not st.get("account_id") or ev == "SessionStart":
            st["account_id"] = acct["id"]
        for k in ("cwd", "model", "transcript_path"):
            if payload.get(k):
                st[k] = payload[k]
        if st["kind"] in ("unknown", "side") or ev == "SessionStart":
            link_session(st)
        if ev == "SessionStart":
            log_event("session_start", sid=sid, session_kind=st.get("kind"), model=payload.get("model"), cwd=payload.get("cwd"),
                      source=payload.get("source"), account=acct["id"])
        if ev == "UserPromptSubmit":
            st["turns"] = int(st.get("turns") or 0) + 1
            deliver_alerts(st, out, True, cfg)
        elif ev == "PreToolUse":
            st["tools"].append({"ts": now(), "name": payload.get("tool_name"), "cmd": tool_command_preview(payload)})
            st["tools"] = st["tools"][-300:]
            if cfg.get("halt_on_mismatch") and st.get("halt") and not is_dgc_command(payload):
                reason = (f"is-gpt-nerfed halt: {st['halt'].get('detail')} Work tools are blocked until the user explicitly asks to "
                          f"resume; then run `{DGC_BIN} resume --thread {sid}`.")
                log_event("halt_block", sid=sid, tool=payload.get("tool_name"), command=tool_command_preview(payload)[:120], probe=st["halt"].get("id"))
                out.update({"decision": "deny", "reason": reason,
                            "hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": reason},
                            "systemMessage": f"is-gpt-nerfed: halted this session after a mismatch (halt_on_mismatch=true)."})
            else:
                deliver_alerts(st, out, True, cfg)
        elif ev == "Stop":
            messages = []
            if cfg.get("passive", True) and st.get("transcript_path") and os.path.exists(st["transcript_path"]):
                for e in scan_rollout(st["transcript_path"], st["scan"], hidden_models()):
                    st["evidence"].append(e)
                    log_event("scan_finding", level="warn" if e["severity"] in ("hard", "soft") else "info", sid=sid,
                              severity=e["severity"], finding=e["kind"], detail=e["detail"], turn=e.get("turn_id"))
                    if e["severity"] == "hard":
                        messages.append(pet_line("DOWNGRADED_HARD", seed=e["detail"], detail=e["detail"]))
                        play_sound(cfg)
                    elif e["severity"] == "soft":
                        messages.append(pet_line("SETTINGS_DOWNGRADE", detail=e["detail"]))
                    elif e["severity"] == "good":
                        messages.append(pet_line("UPGRADED", seed=e["detail"], detail=e["detail"]))
            run_schedule(st, cfg, acct, messages)
            if st["kind"] == "main" and fresh_due(cfg, acct["id"]) and spawn_fresh_worker():
                log_event("fresh_due", why=f"{cfg.get('fresh_frequency')} elapsed", triggered_by=sid)
            if messages:
                out["systemMessage"] = "is-gpt-nerfed: " + "\n".join(messages)
                notify(cfg, messages[0], subtitle="is-gpt-nerfed")
            deliver_alerts(st, out, False, cfg)
        elif ev == "SessionEnd":
            st["ended"] = iso()
    if out:
        print(json.dumps(out))
    return 0


def cmd_resume(args) -> int:
    tid, _ = resolve_thread(args.thread)
    if not tid:
        raise SystemExit("pass --thread <id>")
    with locked_session(tid) as st:
        st["halt"] = None
    log_event("halt_cleared", sid=tid)
    print(f"halt cleared for session {tid}")
    return 0


# ------------------------------------------------------------------------------------ reporting


EVIDENCE_DIMENSION = {"silent_model_change": "model", "applied_model_change": "model", "hidden_model": "model",
                      "silent_effort_change": "effort", "applied_effort_change": "effort",
                      "context_window_change": "ctx", "service_tier_change": "tier"}


def active_evidence(evs: list) -> list:
    """Findings that still describe the current state: for each dimension (model, effort, context window, tier)
    only the latest change counts, so a downgrade that was later reverted stops being an alert (it stays in the
    log and report)."""
    latest: dict = {}
    for e in evs or []:
        latest[EVIDENCE_DIMENSION.get(e.get("kind"), e.get("kind"))] = e
    return [e for e in latest.values() if e.get("severity") in ("hard", "soft", "good")]


def at_usage_limit(e: dict) -> bool:
    pct = e.get("usage_percent")
    return isinstance(pct, (int, float)) and pct >= 90


def compact_evidence(e: dict) -> str:
    """One short line for the panel (the full sentence stays in the ledger, report and pet quotes)."""
    kind, detail = e.get("kind") or "", e.get("detail") or ""
    m = re.search(r"(\S+) → (\S+)", detail)
    a, b = (m.group(1), m.group(2)) if m else (None, None)

    def k(v: str) -> str:
        return f"{int(v) // 1000}k" if v.isdigit() and int(v) >= 1000 else v

    if kind == "silent_model_change" and a:
        return f"Upgraded: {a} → {b}" if e.get("severity") == "good" else f"Silent model change: {a} → {b}"
    if kind == "applied_model_change" and a:
        if e.get("severity") == "good":
            return f"Upgraded: {a} → {b} · via settings"
        return f"Codex switched model {a} → {b} at the usage limit ({e.get('usage_percent'):.0f}%)" if at_usage_limit(e) else f"Settings: model {a} → {b} · was that you?"
    if kind == "silent_effort_change" and a:
        return f"Silent effort change: {a} → {b}"
    if kind == "applied_effort_change" and a:
        return f"Codex switched effort {a} → {b} at the usage limit ({e.get('usage_percent'):.0f}%)" if at_usage_limit(e) else f"Settings: effort {a} → {b} · was that you?"
    if kind == "hidden_model":
        m2 = re.search(r"model (\S+) ran", detail)
        return f"Hidden model ran: {m2.group(1)}" if m2 else "Hidden model ran a turn"
    if kind == "context_window_change" and a:
        return f"Context window {k(a)} → {k(b)}"
    if kind == "service_tier_change" and a:
        return f"Tier {a} → {b}"
    return detail[:80]


def evidence_line(e: dict) -> str:
    return f"{e['kind']} [{e['severity']}] {e['detail']}"


def ago(ts: float | None) -> str:
    if not ts:
        return ""
    d = max(0, int(now() - ts))
    if d < 60:
        return f"{d}s ago"
    if d < 3600:
        return f"{d // 60}m ago"
    if d < 86400:
        return f"{d // 3600}h ago"
    return f"{d // 86400}d ago"


def parse_iso(s) -> float | None:
    try:
        return dt.datetime.strptime(str(s), "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc).timestamp()
    except Exception:
        return None


def write_bin_hint() -> None:
    try:
        ensure_dirs()
        with open(os.path.join(NERFED_HOME, "nerfed_bin"), "w", encoding="utf-8") as f:
            f.write(DGC_BIN + "\n")
    except OSError:
        pass


NON_INTERACTIVE_ORIGINATORS = ("codex_exec",)  # one-shot `codex exec` runs are not sessions anyone works in


def interactive_thread(row: dict | None) -> bool:
    orig = (row or {}).get("originator") or ""
    return not orig.startswith(NON_INTERACTIVE_ORIGINATORS)


def db_recent_threads_detailed(since_ms: int, limit: int = 40) -> list[dict]:
    base = (f"FROM threads WHERE archived = 0 AND (thread_source IS NULL OR thread_source != 'subagent') "
            f"AND (originator IS NULL OR originator NOT LIKE 'codex_exec%') "
            f"AND updated_at_ms >= ? ORDER BY updated_at_ms DESC LIMIT ?")
    rows = db_query(f"SELECT {THREAD_COLS}, preview {base}", (since_ms, limit))
    if not rows:
        rows = db_query(f"SELECT {THREAD_COLS} {base}", (since_ms, limit))
    return rows


def probe_line(p: dict) -> str:
    """One-line report of a probe summary: 'Match · gpt-6-astra 100% · 3 of 3 answers · 41 s · 5m ago · probe a1b2c3d4e5'."""
    v = p.get("verdict") or ("Failed" if p.get("status") == "failed" else "…")
    word = {"DOWNGRADED!": "Downgraded", "MISMATCH": {"downgrade": "Downgrade", "upgrade": "Upgrade"}.get(p.get("direction") or "", "Rerouted"),
            "SUSPICIOUS": "Suspicious", "MATCH": "Match", "UNLISTED": "Unlisted", "INVALID": "Invalid"}.get(v, str(v).capitalize())
    parts = [word]
    server_differs = bool(p.get("server_model")) and p.get("server_state") in SERVER_NAMED_OTHER
    if v == "INVALID" or p.get("status") == "failed":
        parts.append((p.get("errors") or ["no usable sample"])[0])
    else:
        server = f"server: {p['server_model']}" if server_differs else None
        if server and p.get("direction") == "server":  # the server made the verdict: its answer leads
            parts.append(server)
        if p.get("prediction") or not server:
            text = p.get("prediction") or "?"
            if isinstance(p.get("probability"), (int, float)):
                text += f" {p['probability']:.0%}"
            if p.get("expected") and p.get("expected") != p.get("prediction") and isinstance(p.get("p_expected"), (int, float)):
                text += f", declared {p['p_expected']:.0%}"
            parts.append(text)
        if server and p.get("direction") != "server":
            parts.append(server)
    n, q = p.get("used_outputs"), p.get("queries")
    if isinstance(n, int) and isinstance(q, int) and q:
        parts.append(f"{n} of {q} answers")
    if (p.get("rounds") or 1) > 1:
        parts.append(f"{p['rounds']} rounds")
    if p.get("retries"):
        parts.append("retried once" if p["retries"] == 1 else f"retried {p['retries']}×")
    if isinstance(p.get("elapsed_s"), (int, float)):
        parts.append(f"{p['elapsed_s']:.0f} s")
    if p.get("finished_ago"):
        parts.append(p["finished_ago"])
    if p.get("originator"):
        parts.append(f"as {p['originator']}")
    if p.get("stale_account"):  # a verdict from another account is not one for this account
        parts[0] = "Unverified"
        parts.insert(1, f"{word}, account unknown" if p.get("account_state") == "unknown" else f"{word}, another account")
    parts.append(f"probe {p.get('id')}")
    return " · ".join(parts)


SERVER_NAMED_OTHER = ("downgrade", "lateral", "upgrade")  # the server named a known model other than the one asked for


def server_report_value(p: dict) -> str:
    """The report's Server line: 'gpt-6-astra, as asked' · 'gpt-5.6-luna, asked for gpt-6-astra' · 'no answer: …'."""
    state, model = p.get("server_state"), p.get("server_model")
    if state == "failed":
        return f"no answer: {p.get('server_error') or 'unknown error'}"
    if state == "same":
        return f"{model}, as asked"
    line = f"{model}, asked for {p.get('server_requested') or p.get('expected') or '?'}"
    return line + " · unknown name, not counted" if state == "unrecognized" else line


def probe_row_valid(r: dict) -> bool:
    """A probe that produced a verdict. A failed attempt (Invalid: no usable answer, transport error) is the tool's
    own problem, not information about the model; it only asks for a Retry."""
    return r.get("status") != "failed" and r.get("verdict") not in (None, "INVALID")


def evidence_entries(evs: list, active: list, limit: int = 8) -> list[dict]:
    """Hard and soft findings of one thread for the panel's in-place report, newest first; `active` marks the ones
    still in effect (the others were reverted by a later change and stay for the record)."""
    keys = {(a.get("kind"), a.get("ts")) for a in active}
    rows = [e for e in evs if e.get("severity") in ("hard", "soft", "good")][-limit:]
    return [{"text": compact_evidence(e), "ts": e.get("ts"), "ago": ago(parse_iso(e.get("ts"))), "severity": e.get("severity"),
             "active": (e.get("kind"), e.get("ts")) in keys} for e in rows][::-1]


def report_text_for(title: str, model: str | None, effort: str | None, probes: list[dict], evidence: list[dict],
                    failure: dict | None = None) -> str:
    """Plain-text report of one session (what 'Copy report' puts on the clipboard)."""
    lines = [f"is-gpt-nerfed · {title} · {model or '?'}" + (f" @ {effort}" if effort else "")]
    for i, p in enumerate(probes):
        lines.append(("Last probe" if i == 0 else "Earlier") + " · " + probe_line(p))
        if i == 0 and p.get("results") and not p.get("stale_account"):
            lines.append("Fingerprint · " + " · ".join(f"{r.get('model')} {(r.get('probability') or 0):.0%}" for r in p["results"]))
        if i == 0 and p.get("server_state") and not p.get("stale_account"):
            lines.append("Server · " + server_report_value(p))
    if not probes:
        lines.append("No probe yet")
    if failure:
        lines.append("Last attempt · " + probe_line(failure))
    for e in evidence:
        lines.append(f"Evidence · {e['text']}" + (f" · {e['ago']}" if e.get("ago") else "") + ("" if e.get("active", True) else " · reverted"))
    return "\n".join(lines)


def probe_summary(row: dict, current: str | None = None) -> dict:
    full = read_json(probe_path(row["id"]), {}) or {}
    errors = full.get("errors") or []
    verdict = row.get("verdict") or full.get("verdict")
    status = row.get("status") or full.get("status")
    finished_ts = parse_iso(row.get("finished") or full.get("finished"))
    account_id = row.get("account_id") or (full.get("account") or {}).get("id")
    return {
        "account_id": account_id, "stale_account": stale_for_account(account_id, current) if current else False,
        "account_state": account_state(account_id, current),
        "id": row["id"], "thread_id": row.get("thread_id"), "mode": row.get("mode"), "status": status,
        "finished": row.get("finished"), "finished_ts": finished_ts, "finished_ago": ago(finished_ts),
        "verdict": verdict, "direction": row.get("direction"), "expected": row.get("expected"), "prediction": row.get("prediction"),
        "probability": row.get("probability"), "p_expected": row.get("p_expected", full.get("p_expected")),
        "margin": row.get("margin", full.get("margin")), "confidence": row.get("confidence", full.get("confidence")),
        "used_outputs": row.get("used_outputs"), "queries": (row.get("queries") or 1) * (row.get("rounds") or full.get("rounds") or 1),
        "rounds": row.get("rounds") or full.get("rounds") or 1,
        "elapsed_s": row.get("elapsed_s"), "errors": errors[:4], "quote": full.get("quote"), "started": full.get("started"),
        "originator": full.get("originator"),
        "results": [{"model": r.get("model"), "probability": r.get("probability")} for r in (full.get("results") or [])[:4]],
        "server_model": (full.get("server") or {}).get("model"), "server_state": (full.get("server") or {}).get("state"),
        "server_requested": (full.get("server") or {}).get("requested"), "server_error": (full.get("server") or {}).get("error"),
        "is_downgrade": verdict == "DOWNGRADED!" or (verdict == "MISMATCH" and row.get("direction") == "downgrade"),
        "is_upgrade": verdict == "MISMATCH" and row.get("direction") == "upgrade",
        "is_suspicious": verdict == "SUSPICIOUS",
        "retryable": (status == "failed" or verdict == "INVALID") and (not errors or transport_like(errors)),
        "retries": row.get("retries") or full.get("retries") or 0,
    }


def demo_snapshot(cfg: dict) -> dict:
    """Synthetic English sample data for screenshots (`nerfed snapshot --demo`). Nothing here is read from disk."""
    t0 = now()
    cfg = dict(DEFAULT_CONFIG)  # default settings, not this Mac's

    def probe(pid, tid, verdict, direction=None, expected="gpt-6-astra", pred="gpt-6-astra", p=1.0, p_exp=None, margin=None,
              n=3, q=3, ago_s=300, errors=None, status="done", rounds=1, retries=0, mode="fork", stale=False, results=None):
        return {"id": pid, "thread_id": tid, "mode": mode, "status": status, "finished": iso(t0 - ago_s), "finished_ts": t0 - ago_s,
                "started": iso(t0 - ago_s - 41),
                "results": results if results is not None else ([{"model": pred, "probability": p}] if pred and p is not None else []),
                "account_id": "other0" if stale else "demo00", "stale_account": stale,
                "finished_ago": ago(t0 - ago_s), "verdict": verdict, "direction": direction, "expected": expected, "prediction": pred,
                "probability": p, "p_expected": p_exp if p_exp is not None else (None if p is None else (p if pred == expected else round(1 - p, 2))),
                "margin": margin, "confidence": None if p is None else ("high" if p >= 0.8 else "low"), "used_outputs": n, "queries": q, "rounds": rounds,
                "elapsed_s": 41.0, "errors": errors or [], "quote": "", "is_downgrade": verdict == "DOWNGRADED!" or (verdict == "MISMATCH" and direction == "downgrade"),
                "is_upgrade": verdict == "MISMATCH" and direction == "upgrade",
                "is_suspicious": verdict == "SUSPICIOUS", "retryable": status == "failed" or verdict == "INVALID", "retries": retries}

    def thread(tid, title, model, effort, turns, ago_s, last, hard=0, soft=0, ev=None, due=False, running=False, halted=False,
               probes=None, evidence=None, failure=None, good=0):
        stale = bool(last and last.get("stale_account"))
        return {"id": tid, "title": title, "cwd": "/Users/you/code/" + tid, "model": model, "effort": effort, "updated_ts": t0 - ago_s,
                "probes": probes if probes is not None else ([last] if last else []), "evidence": evidence or [], "last_failure": failure,
                "good_evidence": good, "upgraded": good > 0 and not hard, "last_evidence_severity": "hard" if hard else ("soft" if soft else ("good" if good else None)),
                "evidence_history": len(evidence or []), "last_evidence_ago": (evidence or [{}])[0].get("ago") if ev else None,
                "updated": iso(t0 - ago_s), "updated_ago": ago(t0 - ago_s), "active": ago_s < 15 * 60, "turns": turns,
                "turns_since_probe": min(turns, 5), "due": due or stale, "probe_running": running, "halted": halted, "requested": False,
                "hard_evidence": hard, "soft_evidence": soft, "last_evidence": ev, "last_probe": last, "unverified": stale,
                "alert": hard > 0 or bool(last and last["is_downgrade"] and not stale),
                "suspicious": bool(last and last["is_suspicious"] and not stale)}

    pay_last = probe("a1b2c3d4e5", "payments", "MISMATCH", "downgrade", pred="gpt-5.6-luna", p=0.91, p_exp=0.03, margin=1.31, ago_s=240,
                     results=[{"model": "gpt-5.6-luna", "probability": 0.91}, {"model": "gpt-6-astra", "probability": 0.03},
                              {"model": "gpt-5.6-sol", "probability": 0.02}, {"model": "gpt-5.3-codex", "probability": 0.02}])
    pay_earlier = [probe("9a8b7c6d5e", "payments", "MATCH", p=1.0, margin=0.0, ago_s=7500),
                   probe("8b7c6d5e4f", "payments", "MATCH", p=0.99, margin=0.0, ago_s=14200)]
    ci_last = probe("b2c3d4e5f6", "ci-flaky", "SUSPICIOUS", "downgrade", pred="gpt-5.6-sol", p=0.62, p_exp=0.31, margin=0.28, ago_s=660,
                    results=[{"model": "gpt-5.6-sol", "probability": 0.62}, {"model": "gpt-6-astra", "probability": 0.31},
                             {"model": "gpt-5.6-luna", "probability": 0.05}])
    pg_probes = [probe("d4e5f6a7b8", "pg17", "MATCH", expected="gpt-5.6-sol", pred="gpt-5.6-sol", p=1.0, margin=0.0, ago_s=3480, stale=True)]
    pg_probes += [probe(f"r{i}", "pg17", "MATCH", expected="gpt-5.6-sol", pred="gpt-5.6-sol", p=1.0, ago_s=7200 + i * 3600, stale=True) for i in range(3)]
    threads = [
        thread("payments", "Refactor payment webhooks", "gpt-6-astra", "xhigh", 14, 120, pay_last, hard=1,
               ev="Silent model change: gpt-6-astra → gpt-reserve", probes=[pay_last] + pay_earlier,
               evidence=[{"text": "Silent model change: gpt-6-astra → gpt-reserve", "ts": iso(t0 - 540), "ago": ago(t0 - 540), "severity": "hard", "active": True},
                         {"text": "Settings: effort xhigh → medium · was that you?", "ts": iso(t0 - 9000), "ago": ago(t0 - 9000), "severity": "soft", "active": False}]),
        thread("ci-flaky", "Investigate flaky CI on main", "gpt-6-astra", "high", 6, 300, ci_last),
        thread("oauth", "Add OAuth device flow", "gpt-6-astra", "max", 22, 720,
               probe("c3d4e5f6a7", "oauth", "MATCH", p=1.0, margin=0.0, ago_s=10800),
               failure=probe("c3d4e5f6a8", "oauth", "INVALID", status="failed", pred=None, p=None, p_exp=None, n=0,
                             errors=["codex thread/fork timed out after 45s"], retries=1, ago_s=1200)),
        thread("docs", "Rewrite the docs site", "gpt-6-sol", "high", 5, 2400,
               probe("f7a8b9c0d1", "docs", "MATCH", expected="gpt-6-sol", pred="gpt-6-sol", p=1.0, margin=0.0, ago_s=2100), good=1,
               ev="Upgraded: gpt-5.6-sol → gpt-6-sol",
               evidence=[{"text": "Upgraded: gpt-5.6-sol → gpt-6-sol", "ts": iso(t0 - 2600), "ago": ago(t0 - 2600), "severity": "good", "active": True}]),
        thread("pg17", "Migrate to Postgres 17", "gpt-5.6-sol", "high", 9, 3600, pg_probes[0], probes=pg_probes),
        thread("relnotes", "Write release notes v2.3", "gpt-6-astra", "medium", 3, 10800, None, due=True),
    ]
    fresh = probe("e5f6a7b8c9", None, "MATCH", p=1.0, margin=0.0, ago_s=1800, mode="fresh")
    fresh_probes = [fresh, probe("f6a7b8c9d0", None, "MATCH", p=1.0, margin=0.0, ago_s=5400, mode="fresh")]
    for t in threads:
        t["report_text"] = report_text_for(t["title"], t["model"], t["effort"], t["probes"], t["evidence"], t.get("last_failure"))
    recent = [threads[0]["last_probe"], threads[1]["last_probe"], threads[2]["last_probe"], fresh, threads[3]["last_probe"]] + pg_probes[1:]
    return {"generated": iso(), "version": VERSION, "nerfed_bin": DGC_BIN, "ledger": "~/.codex/is-gpt-nerfed", "config": cfg,
            "hooks_last_event": iso(t0 - 12), "hooks_last_event_ago": "12s ago",
            "hooks": {"checked": iso(t0 - 300), "checked_ago": "5m ago", "total": 5, "trusted": 5, "untrusted": 0, "state": "trusted",
                      "error": None, "last_desktop_event": iso(t0 - 12), "last_desktop_event_ago": "12s ago", "desktop_loaded": True,
                      "installed_ago": "2h ago", "desktop_loaded_current": True, "stale_since_install_s": None},
            "install": {"plugin_enabled": True, "codex_found": True, "marketplace_root": "/Applications/IsGPTNerfed.app/Contents/Resources/marketplace", "bundled": True},
            "update": {"current": VERSION, "latest": VERSION, "available": False, "url": RELEASES_URL, "checked": iso(t0 - 10800),
                       "checked_ago": "3h ago", "error": None, "enabled": True},
            "fresh_due": False,
            "account": {"label": "y…@example.com", "plan": "plus", "switched_at": iso(t0 - 2700), "switched_ago": "45m ago",
                        "previous_label": "o…@example.com"},
            "overall": {"status": "alert", "downgraded": 1, "suspicious": 1, "unverified": 1, "upgraded": 1, "running": 0,
                        "message": "1 downgraded · 1 suspicious · 1 upgraded · 1 unverified"},
            "default_model": "gpt-6-astra", "default_effort": "high", "global_probe": fresh, "global_running": False, "global_alert": False,
            "global_probes": fresh_probes, "global_report_text": report_text_for("Fresh session", "gpt-6-astra", "high", fresh_probes, []),
            "global_failure": None, "last_verdict": pay_last, "global_upgraded": False,
            "threads": threads, "recent_probes": recent, "demo": True}


def migrate_untagged_records(account_id: str) -> None:
    """Records made before accounts were recorded cannot be attributed to any account, so they are marked
    `unknown` and count as unverified. (v1 of this migration wrongly gave them to whoever was signed in when it
    ran, which hid an account switch; v2 undoes that. Runs once.)"""
    marker = os.path.join(NERFED_HOME, ".accounts-migrated")
    version = ""
    if os.path.exists(marker):
        with open(marker, "r", encoding="utf-8") as f:
            version = f.read().strip()
    if version.startswith("v2"):
        return
    changed = 0
    if os.path.exists(PROBES_INDEX):
        rows = list(iter_jsonl(PROBES_INDEX))
        for r in rows:
            rec = read_json(probe_path(r["id"]), {}) or {}
            acc = rec.get("account") or {}
            v1_tagged = bool(acc.get("id")) and acc.get("label") == "" and acc.get("plan") is None
            if not r.get("account_id") or v1_tagged:
                r["account_id"] = UNKNOWN_ACCOUNT
                changed += 1
                if rec:
                    rec["account"] = {"id": UNKNOWN_ACCOUNT, "label": "", "plan": None, "note": "recorded before accounts were tracked"}
                    write_json(probe_path(r["id"]), rec)
        if changed:
            tmp = PROBES_INDEX + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                for r in rows:
                    f.write(json.dumps(r, ensure_ascii=False) + "\n")
            os.replace(tmp, PROBES_INDEX)
    for st in all_sessions():
        if st.get("probes") and not st.get("last_probe_account"):
            st["last_probe_account"] = UNKNOWN_ACCOUNT
            save_session(st)
    with open(marker, "w") as f:
        f.write("v2 " + iso() + "\n")
    log_event("migration", version="v2-accounts", records_marked_unknown=changed, current_account=account_id)


def cmd_snapshot(args) -> int:
    """Everything the menu-bar app needs, as one JSON document."""
    cfg = load_config()
    ensure_dirs()
    write_bin_hint()
    if getattr(args, "demo", False):
        snap = demo_snapshot(cfg)
    else:
        snap = build_snapshot(cfg, hours=float(getattr(args, "hours", 48) or 48))
    print(json.dumps(snap, ensure_ascii=False, indent=2 if getattr(args, "pretty", False) else None))
    return 0


def build_snapshot(cfg: dict, hours: float = 48.0) -> dict:
    acct = note_account("snapshot")
    migrate_untagged_records(acct["id"])
    horizon = hours * 3600
    cutoff = now() - horizon
    threads: dict[str, dict] = {}
    for row in db_recent_threads_detailed(int(cutoff * 1000)):
        threads[row["id"]] = {
            "id": row["id"], "title": (row.get("name") or row.get("title") or (row.get("preview") or "").strip()[:70] or row["id"][:12]),
            "cwd": row.get("cwd"), "model": row.get("model"), "effort": row.get("reasoning_effort"),
            "updated_ts": (row.get("updated_at_ms") or 0) / 1000.0, "turns": 0, "turns_since_probe": 0, "due": False,
            "probe_running": False, "halted": False, "requested": False, "hard_evidence": 0, "soft_evidence": 0, "last_evidence": None,
        }
    for st in all_sessions():
        if st.get("kind") != "main":
            continue
        upd = parse_iso(st.get("updated")) or 0
        if upd < cutoff and st["sid"] not in threads:
            continue
        if st["sid"] not in threads and not interactive_thread(db_thread(st["sid"])):
            continue
        t = threads.setdefault(st["sid"], {"id": st["sid"], "title": st["sid"][:12], "cwd": st.get("cwd"), "model": st.get("model"),
                                           "effort": None, "updated_ts": 0, "turns": 0, "turns_since_probe": 0, "due": False,
                                           "probe_running": False, "halted": False, "requested": False, "hard_evidence": 0,
                                           "soft_evidence": 0, "last_evidence": None})
        t["updated_ts"] = max(t["updated_ts"], upd)
        t["model"] = (st.get("scan") or {}).get("model") or t.get("model") or st.get("model")
        t["effort"] = (st.get("scan") or {}).get("effort") or t.get("effort")
        t["cwd"] = t.get("cwd") or st.get("cwd")
        t["turns"] = int(st.get("turns") or 0)
        t["turns_since_probe"] = int(st.get("turns") or 0) - int(st.get("last_probe_turn") or 0)
        t["due"] = probe_due(st, cfg, acct["id"])
        running = st.get("probe_running") or {}
        t["probe_running"] = bool(running) and (running.get("pid") is None or pid_alive(running.get("pid")))
        t["_probe_note"] = (running or {}).get("note") if t["probe_running"] else None
        t["halted"] = bool(st.get("halt"))
        t["requested"] = bool(st.get("requested"))
        active = sorted(active_evidence(st.get("evidence") or []), key=lambda e: e.get("ts") or "")
        t["hard_evidence"] = sum(1 for e in active if e.get("severity") == "hard")
        t["soft_evidence"] = sum(1 for e in active if e.get("severity") == "soft")
        t["good_evidence"] = sum(1 for e in active if e.get("severity") == "good")
        t["evidence_history"] = sum(1 for e in st.get("evidence") or [] if e.get("severity") in ("hard", "soft", "good"))
        shown = ([e for e in active if e.get("severity") == "hard"] or [e for e in active if e.get("severity") == "soft"]
                 or [e for e in active if e.get("severity") == "good"])  # the row shows the worst class, and its newest finding
        t["last_evidence"] = compact_evidence(shown[-1]) if shown else None
        t["last_evidence_ago"] = ago(parse_iso(shown[-1].get("ts"))) if shown else None
        t["last_evidence_severity"] = shown[-1].get("severity") if shown else None
        t["evidence"] = evidence_entries(st.get("evidence") or [], active)
    index_rows = list(iter_jsonl(PROBES_INDEX))
    by_thread: dict[str, list] = {}
    for row in index_rows:
        if row.get("thread_id"):
            by_thread.setdefault(row["thread_id"], []).append(row)
    out_threads = []
    downgraded = running = suspicious = unverified = upgraded = 0
    for t in threads.values():
        rows = by_thread.get(t["id"], [])
        valid = [r for r in rows if probe_row_valid(r)]
        t["last_probe"] = probe_summary(valid[-1], acct["id"]) if valid else None  # the verdict
        failed = rows[-1] if rows and not probe_row_valid(rows[-1]) else None      # a newer failed attempt: Retry
        t["last_failure"] = probe_summary(failed, acct["id"]) if failed else None
        t["probes"] = [probe_summary(r, acct["id"]) for r in valid[-5:]][::-1]
        t.setdefault("evidence", [])
        stale = bool(t["last_probe"] and t["last_probe"]["stale_account"])
        t["unverified"] = stale  # verdict obtained under another Codex account: says nothing about this one
        t["updated"] = iso(t["updated_ts"]) if t["updated_ts"] else None
        t["updated_ago"] = ago(t["updated_ts"])
        t["active"] = bool(t["updated_ts"]) and (now() - t["updated_ts"]) < ACTIVE_WINDOW_S
        t["alert"] = t["hard_evidence"] > 0 or bool(t["last_probe"] and t["last_probe"]["is_downgrade"] and not stale)
        t["suspicious"] = bool(t["last_probe"] and t["last_probe"]["is_suspicious"] and not stale) and not t["alert"]
        t.setdefault("good_evidence", 0)
        t.setdefault("last_evidence_severity", None)
        t["upgraded"] = (t["good_evidence"] > 0 or bool(t["last_probe"] and t["last_probe"].get("is_upgrade") and not stale)) \
            and not t["alert"] and not t["suspicious"]
        downgraded += 1 if t["alert"] else 0
        suspicious += 1 if t["suspicious"] else 0
        upgraded += 1 if t["upgraded"] else 0
        unverified += 1 if stale else 0
        running += 1 if t["probe_running"] else 0
        out_threads.append(t)
    out_threads.sort(key=lambda t: (not t["alert"], not t["suspicious"], not t["upgraded"], -(t["updated_ts"] or 0)))
    evs = tail_jsonl(EVENTS_PATH, 1)
    last_event = evs[0] if evs else None
    fresh_rows = [r for r in index_rows if r.get("mode") == "fresh"]
    fresh_valid = [r for r in fresh_rows if probe_row_valid(r)]
    global_probe = probe_summary(fresh_valid[-1], acct["id"]) if fresh_valid else None
    global_failure = probe_summary(fresh_rows[-1], acct["id"]) if fresh_rows and not probe_row_valid(fresh_rows[-1]) else None
    valid_rows = [r for r in index_rows if probe_row_valid(r)]
    last_verdict = probe_summary(valid_rows[-1], acct["id"]) if valid_rows else None
    global_stale = bool(global_probe and global_probe["stale_account"])
    global_alert = bool(global_probe and global_probe["is_downgrade"] and not global_stale)
    global_upgraded = bool(global_probe and global_probe.get("is_upgrade") and not global_stale)
    upgraded += 1 if global_upgraded else 0
    fr = fresh_running()
    downgraded += 1 if global_alert else 0
    suspicious += 1 if (global_probe and global_probe["is_suspicious"] and not global_alert and not global_stale) else 0
    unverified += 1 if global_stale else 0
    running += 1 if fr else 0
    default_model, default_effort = default_model_settings()
    parts = []  # the first part is the panel's headline: a problem if there is one, otherwise "all clear"
    if downgraded:
        parts.append("fresh session downgraded" if global_alert and downgraded == 1 else f"{downgraded} downgraded")
    if suspicious:
        parts.append(f"{suspicious} suspicious")
    if not parts:
        parts.append(f"{upgraded} upgraded" if upgraded else ("all clear" if (out_threads or global_probe) else "no active threads"))
    elif upgraded:
        parts.append(f"{upgraded} upgraded")
    if unverified:  # a verdict from another account (or from before accounts were tracked): not a problem, just not current
        parts.append(f"{unverified} unverified")
    if running:
        parts.append(f"{running} probe{'s' if running > 1 else ''} running")
    message = " · ".join(parts)
    status = "alert" if downgraded else ("warn" if suspicious else ("upgraded" if upgraded else ("unverified" if unverified else "ok")))
    for t in out_threads:  # surface the worker's progress note (e.g. waiting for a live turn to finish)
        t["probe_note"] = t.pop("_probe_note", None)
    account_label = acct["label"]
    if cfg.get("hide_titles"):  # screenshot mode: neutral thread names, no account
        for i, t in enumerate(out_threads, 1):
            t["title"] = f"Session {i}"
            t["cwd"] = None
        account_label = "account hidden"
    for t in out_threads:  # the in-place report behind each row (and what Copy report puts on the clipboard)
        t["report_text"] = report_text_for(t["title"], t.get("model"), t.get("effort"), t.get("probes") or [], t.get("evidence") or [],
                                           t.get("last_failure"))
    global_probes = [probe_summary(r, acct["id"]) for r in fresh_valid[-5:]][::-1]
    global_report_text = report_text_for("Fresh session", default_model, default_effort, global_probes, [], global_failure)
    hooks = hooks_status(cfg)
    state = read_json(STATE_PATH, {}) or {}
    if state.get("last_status") != status or state.get("last_message") != message:
        log_event("status_change", level="warn" if status in ("alert", "warn") else "info", from_status=state.get("last_status"),
                  to_status=status, message=message, downgraded=downgraded, suspicious=suspicious, unverified=unverified, upgraded=upgraded)
        write_json(STATE_PATH, {**state, "last_status": status, "last_message": message, "changed_at": iso()})
    install = {"plugin_enabled": plugin_enabled_in_config(), "codex_found": bool(codex_bin(cfg)),
               "marketplace_root": os.path.dirname(PLUGIN_ROOT), "bundled": "/Contents/Resources/" in PLUGIN_ROOT}
    snap = {"generated": iso(), "version": VERSION, "nerfed_bin": DGC_BIN, "ledger": NERFED_HOME, "config": cfg,
            "hooks_last_event": (last_event or {}).get("ts"), "hooks_last_event_ago": ago(parse_iso((last_event or {}).get("ts"))),
            "hooks": hooks, "install": install, "update": maybe_check_updates(cfg), "fresh_due": fresh_due(cfg, acct["id"]),
            "overall": {"status": status, "downgraded": downgraded, "suspicious": suspicious, "unverified": unverified,
                        "upgraded": upgraded, "running": running, "message": message},
            "default_model": default_model, "default_effort": default_effort,
            "global_probe": global_probe, "global_running": bool(fr), "global_alert": global_alert, "global_upgraded": global_upgraded,
            "global_probes": global_probes, "global_report_text": global_report_text, "global_failure": global_failure,
            "last_verdict": last_verdict,
            "account": {"label": account_label, "plan": acct["plan"], "switched_at": acct.get("switched_at"),
                        "switched_ago": ago(acct.get("switched_ts")) if acct.get("switched_ts") and now() - float(acct["switched_ts"]) < 86400 else None,
                        "previous_label": (acct.get("previous") or {}).get("label")},
            "threads": out_threads, "recent_probes": [probe_summary(r, acct["id"]) for r in index_rows[-10:]][::-1]}
    return snap


def version_tuple(v) -> tuple:
    """'v0.4.2' → (0, 4, 2); anything without digits → (0,)."""
    digits = re.findall(r"\d+", str(v or ""))
    return tuple(int(x) for x in digits[:4]) or (0,)


def update_status(cfg: dict | None = None) -> dict:
    """What the daily release check found (update.json). Never touches the network itself."""
    u = read_json(UPDATE_PATH, {}) or {}
    latest = u.get("latest")
    available = bool(latest) and version_tuple(latest) > version_tuple(VERSION)
    checked = parse_iso(u.get("checked")) if u.get("checked") else None
    return {"current": VERSION, "latest": latest, "available": available, "url": u.get("url") or RELEASES_URL,
            "checked": u.get("checked"), "checked_ago": ago(checked) if checked else None, "error": u.get("error"),
            "status": u.get("status"), "has_archive": bool(u.get("asset_url")),
            "enabled": bool((cfg if cfg is not None else load_config()).get("check_updates", True))}


def pick_release_assets(data: dict) -> tuple[str | None, str | None]:
    """(zip url, sha256 url) from a GitHub release: the first IsGPTNerfed zip, and the checksum file named after
    that very zip (a release also carries the dmg's checksum; the wrong one would fail every update)."""
    assets = [a for a in (data.get("assets") or []) if isinstance(a, dict)]
    zips = sorted((a for a in assets if str(a.get("name", "")).lower().endswith(".zip")),
                  key=lambda a: (not str(a.get("name", "")).startswith("IsGPTNerfed"), str(a.get("name", ""))))
    if not zips:
        return None, None
    want = str(zips[0].get("name")) + ".sha256"
    sha = next((a.get("browser_download_url") for a in assets if a.get("name") == want), None)
    return zips[0].get("browser_download_url"), sha


def fetch_latest_release(u: dict) -> dict:
    """One request to GitHub: the latest release, its zip and its .sha256 (build.sh --zip writes both)."""
    import urllib.error
    import urllib.request
    rec = {**{k: u.get(k) for k in ("latest", "url", "asset_url", "sha256_url", "notified", "status", "installed")},
           "checked": iso(), "error": None}
    rec["url"] = rec.get("url") or RELEASES_URL
    req = urllib.request.Request(RELEASES_API, headers={"User-Agent": f"is-gpt-nerfed/{VERSION}", "Accept": "application/vnd.github+json"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        zip_url, sha_url = pick_release_assets(data)
        rec.update(latest=str(data.get("tag_name") or "").lstrip("v") or None, name=data.get("name"),
                   url=data.get("html_url") or RELEASES_URL, published_at=data.get("published_at"),
                   asset_url=zip_url, sha256_url=sha_url)
    except urllib.error.HTTPError as e:
        rec["error"] = f"HTTP {e.code}"  # 404 while the repository is private: nothing to show
    except Exception as e:
        rec["error"] = str(e)[:160]
    return rec


def cmd_update_install(args) -> int:
    """Download the latest release, verify its checksum, replace the app bundle (the old one goes to the Trash) and
    relaunch it. What the panel's update link runs, detached, so it survives the app it replaces."""
    import hashlib
    import plistlib
    import shutil
    import signal
    import tempfile
    import urllib.request
    import zipfile
    u = read_json(UPDATE_PATH, {}) or {}
    if not u.get("asset_url") or (u.get("latest") and version_tuple(u["latest"]) <= version_tuple(VERSION) and not args.force):
        u = fetch_latest_release(u)
        write_json(UPDATE_PATH, u)
    latest, asset = u.get("latest"), u.get("asset_url")

    def fail(msg: str) -> int:
        log_error(f"update install failed: {msg}")
        write_json(UPDATE_PATH, {**(read_json(UPDATE_PATH, {}) or {}), "status": f"failed: {msg}"[:200]})
        print(f"update failed: {msg}")
        return 1

    if not asset:
        return fail(u.get("error") or "no release archive found")
    if not args.force and latest and version_tuple(latest) <= version_tuple(VERSION):
        return fail(f"{latest} is not newer than {VERSION}")
    dest = args.app or next((p for p in (os.path.expanduser("~/Applications/IsGPTNerfed.app"), "/Applications/IsGPTNerfed.app")
                             if os.path.isdir(p)), None)
    if not dest or not os.path.isdir(dest):
        return fail("cannot find the installed IsGPTNerfed.app")
    write_json(UPDATE_PATH, {**u, "status": "downloading"})
    log_event("update_install", latest=latest, asset=asset, app=dest)
    headers = {"User-Agent": f"is-gpt-nerfed/{VERSION}"}
    tmp = tempfile.mkdtemp(prefix="is-gpt-nerfed-update-")
    zip_path = os.path.join(tmp, "update.zip")
    try:
        with urllib.request.urlopen(urllib.request.Request(asset, headers=headers), timeout=60) as resp, open(zip_path, "wb") as f:
            total = 0
            while True:
                chunk = resp.read(1 << 20)
                if not chunk:
                    break
                total += len(chunk)
                if total > 300 << 20:
                    raise ValueError("archive larger than 300 MB")
                f.write(chunk)
    except Exception as e:
        return fail(f"download: {e}")
    if u.get("sha256_url"):
        try:
            with urllib.request.urlopen(urllib.request.Request(u["sha256_url"], headers=headers), timeout=30) as resp:
                expected = resp.read().decode("utf-8", "replace").split()[0].strip().lower()
            h = hashlib.sha256()
            with open(zip_path, "rb") as f:
                for chunk in iter(lambda: f.read(1 << 20), b""):
                    h.update(chunk)
            if h.hexdigest() != expected:
                return fail("sha256 mismatch: the archive is not the one the release lists")
        except Exception as e:
            return fail(f"checksum: {e}")
    xdir = os.path.join(tmp, "x")
    os.makedirs(xdir, exist_ok=True)
    try:
        if shutil.which("ditto"):
            subprocess.run(["ditto", "-x", "-k", zip_path, xdir], check=True, capture_output=True)
        else:
            with zipfile.ZipFile(zip_path) as z:
                z.extractall(xdir)
    except Exception as e:
        return fail(f"extract: {e}")
    new_app = None
    for root, dirs, _files in os.walk(xdir):
        hit = next((d for d in sorted(dirs) if d.endswith(".app")), None)
        if hit:
            new_app = os.path.join(root, hit)
            break
        if root[len(xdir):].count(os.sep) >= 2:
            dirs[:] = []
    if not new_app:
        return fail("no .app inside the archive")
    try:
        with open(os.path.join(new_app, "Contents", "Info.plist"), "rb") as f:
            got = str(plistlib.load(f).get("CFBundleShortVersionString") or "")
    except Exception as e:
        return fail(f"Info.plist: {e}")
    if latest and version_tuple(got) != version_tuple(latest):
        return fail(f"the archive is version {got}, the release says {latest}")
    pid = int(args.pid) if args.pid else None
    if pid and pid_alive(pid):  # the app that asked for this: stop it before swapping its bundle
        try:
            os.kill(pid, signal.SIGTERM)
        except Exception:
            pass
        for _ in range(60):
            if not pid_alive(pid):
                break
            time.sleep(0.25)
    elif sys.platform == "darwin" and not args.no_launch:
        subprocess.run(["pkill", "-x", "IsGPTNerfed"], capture_output=True)
        time.sleep(1)
    backup_dir = args.backup_dir or os.path.expanduser("~/.Trash")
    if not os.path.isdir(backup_dir):
        backup_dir = tmp
    backup = os.path.join(backup_dir, f"IsGPTNerfed-{VERSION}-{int(now())}.app")
    try:
        shutil.move(dest, backup)
    except Exception as e:
        return fail(f"cannot move the old app aside: {e}")
    try:
        shutil.move(new_app, dest)
    except Exception as e:
        try:
            shutil.move(backup, dest)
        except Exception:
            pass
        return fail(f"cannot put the new app in place: {e}")
    if sys.platform == "darwin":
        subprocess.run(["xattr", "-dr", "com.apple.quarantine", dest], capture_output=True)
    write_json(UPDATE_PATH, {**u, "status": "installed", "installed": got, "installed_at": iso(), "error": None})
    log_event("update_installed", version=got, app=dest, backup=backup)
    if sys.platform == "darwin" and not args.no_launch:
        for _ in range(8):  # LaunchServices can lag right after the swap
            if subprocess.run(["open", dest], capture_output=True).returncode == 0:
                break
            time.sleep(1)
    print(f"installed {got} at {dest} (previous copy: {backup})")
    return 0


def maybe_check_updates(cfg: dict) -> dict:
    """Every UPDATE_INTERVAL_S, and never from tests, fetch the latest release tag in a background process. A failed
    check is recorded in update.json only; the panel shows nothing for it."""
    status = update_status(cfg)
    if status["enabled"] and not os.environ.get("NERFED_NO_UPDATE_CHECK"):
        u = read_json(UPDATE_PATH, {}) or {}
        checked = (parse_iso(u.get("checked")) if u.get("checked") else None) or 0
        started = float(u.get("started_ts") or 0)
        if now() - checked > UPDATE_INTERVAL_S and now() - started > 120:
            write_json(UPDATE_PATH, {**u, "started_ts": now()})
            try:
                subprocess.Popen([sys.executable, DGC_BIN, "update-check"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 stdin=subprocess.DEVNULL, start_new_session=True)
            except Exception as e:
                log_error(f"update check spawn failed: {e}")
    return status


def cmd_update_check(args) -> int:
    """One request to GitHub: the latest release tag. Notifies once per new version."""
    cfg = load_config()
    rec = fetch_latest_release(read_json(UPDATE_PATH, {}) or {})
    available = bool(rec.get("latest")) and version_tuple(rec["latest"]) > version_tuple(VERSION)
    log_event("update_check", latest=rec.get("latest"), available=available, error=rec.get("error"))
    if available and rec.get("notified") != rec["latest"]:
        notify(cfg, f"is-gpt-nerfed {rec['latest']} is out; you run {VERSION}. Open the panel to update.", subtitle="update available")
        rec["notified"] = rec["latest"]
    write_json(UPDATE_PATH, rec)
    print(f"current {VERSION} · latest {rec.get('latest') or '?'}" + (f" · {rec['error']}" if rec.get("error") else "")
          + (" · update available" if available else ""))
    return 0


def hooks_status(cfg: dict, max_age_s: float = 900, force: bool = False) -> dict:
    """Trust state of the plugin's hooks as Codex sees them (hooks/list), cached for `max_age_s`, plus whether
    the desktop app has ever fired one of them (a hook event whose thread was created by Codex Desktop)."""
    cached = read_json(HOOKS_STATUS_PATH, {}) or {}
    fresh = cached.get("checked_ts") and (now() - float(cached["checked_ts"])) < max_age_s
    if force or not fresh:
        cb = codex_bin(cfg)
        if cb:
            try:
                hooks = cas.list_plugin_hooks(cb, f"{PLUGIN_NAME}@{MARKETPLACE_NAME}")
                trusted = sum(1 for h in hooks if h.get("trustStatus") == "trusted")
                cached = {"checked_ts": now(), "checked": iso(), "total": len(hooks), "trusted": trusted, "untrusted": len(hooks) - trusted,
                          "hooks": [{"event": h.get("eventName"), "status": h.get("trustStatus"), "key": h.get("key"), "hash": h.get("currentHash")} for h in hooks],
                          "error": None}
                cached["state"] = "missing" if not hooks else ("trusted" if trusted == len(hooks) else "untrusted")
            except Exception as e:
                cached = {**cached, "checked_ts": now(), "checked": iso(), "error": str(e)[:200], "state": cached.get("state") or "unknown"}
            write_json(HOOKS_STATUS_PATH, cached)
    # desktop evidence: hook events whose thread the Codex Desktop app created
    last_desktop = None
    sids = {}
    for e in tail_jsonl(EVENTS_PATH, 400):
        if e.get("sid"):
            sids[e["sid"]] = e.get("ts")
    if sids:
        marks = ",".join("?" for _ in sids)
        rows = db_query(f"SELECT id, originator FROM threads WHERE id IN ({marks})", tuple(sids))
        desk = [sids[r["id"]] for r in rows if (r.get("originator") or "").startswith("Codex Desktop") and sids.get(r["id"])]
        last_desktop = max(desk) if desk else None
    out = {k: cached.get(k) for k in ("checked", "total", "trusted", "untrusted", "state", "error")}
    out["checked_ago"] = ago(cached.get("checked_ts"))
    out["last_desktop_event"] = last_desktop
    out["last_desktop_event_ago"] = ago(parse_iso(last_desktop)) if last_desktop else None
    out["desktop_loaded"] = bool(last_desktop)
    # after an upgrade the desktop keeps running the previous cached copy until it reloads: compare the newest
    # desktop hook event with the install time of the current version's cache directory
    cache_dir = os.path.join(CODEX_HOME, "plugins", "cache", PLUGIN_NAME, PLUGIN_NAME, VERSION)
    installed_ts = os.path.getmtime(cache_dir) if os.path.isdir(cache_dir) else None
    last_desktop_ts = parse_iso(last_desktop) if last_desktop else None
    out["installed_ago"] = ago(installed_ts) if installed_ts else None
    out["desktop_loaded_current"] = bool(installed_ts and last_desktop_ts and last_desktop_ts >= installed_ts)
    out["stale_since_install_s"] = round(now() - installed_ts) if installed_ts and not out["desktop_loaded_current"] else None
    return out


def cmd_hooks(args) -> int:
    cfg = load_config()
    ensure_dirs()
    cb = codex_bin(cfg)
    if not cb:
        raise SystemExit("codex binary not found")
    plugin_id = f"{PLUGIN_NAME}@{MARKETPLACE_NAME}"
    hooks = cas.list_plugin_hooks(cb, plugin_id)
    if args.action == "trust":
        pending = [h for h in hooks if h.get("trustStatus") != "trusted"]
        if not pending:
            print(f"all {len(hooks)} hooks already trusted")
        else:
            r = cas.trust_hooks(cb, pending)
            log_event("hooks_trust", count=len(pending), events=[h.get("eventName") for h in pending], result=(r or {}).get("status"))
            print(f"trusted {len(pending)} hook(s): " + ", ".join(h.get("eventName") or "?" for h in pending))
            hooks = cas.list_plugin_hooks(cb, plugin_id)
    st = hooks_status(cfg, force=True)
    print(f"{plugin_id}: {st.get('trusted', 0)}/{st.get('total', 0)} hooks trusted  ·  desktop has fired them: "
          f"{'yes, last ' + st['last_desktop_event_ago'] if st.get('desktop_loaded') else 'not yet (restart the Codex app after installing)'}")
    for h in hooks:
        print(f"  {h.get('eventName'):18} {h.get('trustStatus'):10} {h.get('currentHash')}")
    if st.get("untrusted"):
        print(f"→ `{DGC_BIN} hooks trust` records trust for the hook definitions above (what /hooks does in the Codex TUI).")
    return 0 if not st.get("untrusted") else 1


def cmd_log(args) -> int:
    rows = list(iter_jsonl(LOG_PATH))
    if args.since:
        m = re.match(r"^(\d+)\s*([smhd])$", args.since.strip().lower())
        if not m:
            raise SystemExit("--since expects e.g. 30m, 2h, 1d")
        secs = int(m.group(1)) * {"s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]
        cutoff = iso(now() - secs)
        rows = [r for r in rows if (r.get("ts") or "") >= cutoff]
    if args.kind:
        kinds = {k.strip() for k in args.kind.split(",")}
        rows = [r for r in rows if r.get("kind") in kinds]
    if args.probe:
        rows = [r for r in rows if r.get("probe") == args.probe]
    if args.thread:
        rows = [r for r in rows if (r.get("sid") or "").startswith(args.thread)]
    rows = rows[-int(args.last):] if args.last else rows
    if not rows:
        print(f"no matching log entries in {LOG_PATH}")
        return 0
    for r in rows:
        if args.json:
            print(json.dumps(r, ensure_ascii=False))
            continue
        rest = {k: v for k, v in r.items() if k not in ("ts", "kind", "level", "pid")}
        if "forks" in rest:
            rest["forks"] = f"[{len(rest['forks'])} forks]"
        body = " ".join(f"{k}={json.dumps(v, ensure_ascii=False) if not isinstance(v, str) else v}" for k, v in rest.items())
        print(f"{r.get('ts')}  {r.get('level', 'info'):5}  {r.get('kind'):22} {body[:400]}")
    return 0


def cmd_report(args) -> int:
    acct = current_account()
    rows = list(iter_jsonl(PROBES_INDEX))
    other = sum(1 for r in rows if stale_for_account(r.get("account_id"), acct["id"]))
    print(f"is-gpt-nerfed report  ·  ledger {NERFED_HOME}  ·  account {acct['label']}" + (f" ({acct['plan']})" if acct.get("plan") else ""))
    if other:
        print(f"({other} records were made under another Codex account; they are marked * and do not vouch for this account)")
    print()
    if rows:
        print(f"{'finished':20} {'probe':11} {'session':14} {'mode':5} {'expected':16} {'fingerprint':16} {'p':>5} {'n':>3} {'time':>5}  verdict")
        for r in rows[-int(args.last or 30):]:
            p = f"{r['probability'] * 100:4.0f}%" if isinstance(r.get("probability"), (int, float)) else "  —  "
            print(f"{(r.get('finished') or '')[:19]:20} {r.get('id') or '':11} {short(r.get('thread_id'), 12):14} {(r.get('mode') or '')[:5]:5} "
                  f"{(r.get('expected') or '?')[:16]:16} {(r.get('prediction') or '?')[:16]:16} {p:>5} {r.get('used_outputs') or 0:>3} "
                  f"{r.get('elapsed_s') or 0:4.0f}s  {r.get('verdict')}{'*' if stale_for_account(r.get('account_id'), acct['id']) else ''}"
                  + (f" ({r['direction']})" if r.get("direction") else ""))
        print()
        counts: dict = {}
        for r in rows:
            counts[r.get("verdict")] = counts.get(r.get("verdict"), 0) + 1
        print("verdict counts: " + ", ".join(f"{k}={v}" for k, v in counts.items()))
    else:
        print(f"no probes yet. In any Codex session say:  {SKILL_CMD}   (or {SIDE_CMD})")
    print()
    sessions = all_sessions()
    hard = [(s, e) for s in sessions for e in s.get("evidence") or [] if e.get("severity") == "hard"]
    soft = [(s, e) for s in sessions for e in s.get("evidence") or [] if e.get("severity") == "soft"]
    good = [(s, e) for s in sessions for e in s.get("evidence") or [] if e.get("severity") == "good"]
    print(f"passive scanner: {len(sessions)} sessions tracked, {len(hard)} hard findings, {len(soft)} soft findings, {len(good)} upgrades")
    for s, e in (hard + soft + good)[-15:]:
        print(f"  {e.get('ts')}  {short(s['sid'], 12)}  {evidence_line(e)}")
    return 0


def cmd_explain(args) -> int:
    if args.method or not args.probe_id:
        print(METHOD)
        return 0
    rec = read_json(probe_path(args.probe_id))
    if not rec:
        raise SystemExit("unknown probe id")
    print(f"probe {rec['id']}  mode={rec.get('mode')}  status={rec.get('status')}  started={rec.get('started')}  finished={rec.get('finished')}")
    print(f"identified as {rec.get('originator') or '(clientInfo name)'}")
    print(f"session {rec.get('thread_id')}  expected {rec.get('expected')}  →  fingerprint {rec.get('prediction')} "
          f"({(rec.get('probability') or 0) * 100:.1f}%)  verdict {rec.get('verdict')} {rec.get('direction') or ''}")
    if rec.get("calibration"):
        print(f"calibration: {rec['calibration']['queries']} answer(s), beta {rec['calibration']['beta']:.2f}, cv accuracy {rec['calibration']['cv_accuracy']:.1%}")
    print()
    for i, f in enumerate(rec.get("forks") or []):
        if rec.get("mode") == "fork":
            usage = f.get("usage") or {}
            print(f"fork {i + 1}: {f.get('language')} · {f.get('count')} requested · parsed {len(core.parse_numbers(f.get('text') or ''))} · "
                  f"{f.get('elapsed_s')}s · cached {usage.get('cached')}/{usage.get('input')} in, {usage.get('output')} out" + (f" · ERROR {f['error']}" if f.get("error") else ""))
    for i, a in enumerate(rec.get("answers") or []):
        print(f"answer {i + 1}: {a['parsed']} parsed of {a['expected_count']} requested · {'accepted' if a['accepted'] else 'rejected'}")
    if rec.get("results"):
        print()
        print("attribution:")
        for r in rec["results"]:
            print(f"  {r['model']:28} {r['probability'] * 100:5.1f}%   score {r['score']:+.3f}   profile-similarity {r['profile_similarity']:.3f}")
        print("families: " + ", ".join(f"{f['display_name']} {f['probability'] * 100:.1f}%" for f in rec.get("family_probabilities") or []))
    for e in rec.get("hard_evidence") or []:
        print("hard evidence:", e["detail"])
    for e in rec.get("soft_evidence") or []:
        print("needs confirmation:", e["detail"])
    for err in rec.get("errors") or []:
        print("problem:", err)
    print()
    print("pet said:", rec.get("quote"))
    return 0


def cmd_evidence(args) -> int:
    sessions = all_sessions()
    if args.thread:
        sessions = [s for s in sessions if s["sid"].startswith(args.thread) or (s.get("parent_thread_id") or "").startswith(args.thread)]
    count = 0
    for s in sessions:
        evs = [e for e in s.get("evidence") or [] if args.all or e.get("severity") in ("hard", "soft")]
        if not evs:
            continue
        print(f"session {s['sid']}  kind={s.get('kind')}  cwd={s.get('cwd')}  turns={s.get('turns')}")
        for e in evs:
            print(f"   {e.get('ts')}  {evidence_line(e)}")
            count += 1
    if not count:
        print("no evidence recorded" + ("" if args.all else " (use --all to include info-level entries)"))
    return 0


def rollout_for(thread: str | None, path: str | None) -> str:
    if path:
        return path
    if thread:
        row = db_thread(thread)
        if not row:
            rows = db_query(f"SELECT {THREAD_COLS} FROM threads WHERE id LIKE ? ORDER BY updated_at_ms DESC LIMIT 1", (thread + "%",))
            row = rows[0] if rows else None
        if row and row.get("rollout_path"):
            return row["rollout_path"]
        raise SystemExit(f"no rollout found for session {thread}")
    rows = db_recent_main_threads(1)
    if rows:
        return rows[0]["rollout_path"]
    raise SystemExit("no session given and none found in the Codex state DB")


def cmd_scan(args) -> int:
    path = rollout_for(args.thread, args.rollout)
    scan, ev = scan_full(path)
    print(f"rollout: {path}")
    print(f"  originator={scan.get('originator')} cli={scan.get('cli_version')} turns={scan.get('turns')} first model={scan.get('first_model')} "
          f"instructions claim={scan.get('instructions_family')}")
    print(f"  models seen: {scan.get('models_seen')}   efforts seen: {scan.get('efforts_seen')}   ctx window: {scan.get('ctx')}   tier: {scan.get('tier')}")
    for e in ev:
        print(f"  {e['ts']}  {evidence_line(e)}")
    if not ev:
        print("  no model/effort/context-window changes found")
    return 0


def cmd_audit(args) -> int:
    since = now() - float(args.days) * 86400
    files = sorted((p for p in glob.glob(os.path.join(CODEX_HOME, "sessions", "**", "*.jsonl"), recursive=True) if os.path.getmtime(p) >= since),
                   key=os.path.getmtime)
    hidden = hidden_models()
    totals: dict = {}
    scanned = flagged = 0
    for p in files:
        if not args.include_subagents:
            try:
                with open(p, "rb") as f:
                    first = json.loads(f.readline() or b"{}")
                if (first.get("payload") or {}).get("thread_source") == "subagent":
                    continue
            except Exception:
                pass
        scan, ev = scan_full(p, hidden)
        scanned += 1
        for e in ev:
            totals[e["kind"]] = totals.get(e["kind"], 0) + 1
        interesting = [e for e in ev if e["severity"] in ("hard", "soft")]
        if interesting:
            flagged += 1
            print(f"{os.path.basename(p)}  models={scan.get('models_seen')} efforts={list(scan.get('efforts_seen') or {})}")
            for e in interesting:
                print(f"   {e['ts']}  {evidence_line(e)}")
    print()
    print(f"audit: scanned {scanned} rollouts modified in the last {args.days} days; {flagged} with hard/soft findings")
    for k, v in sorted(totals.items(), key=lambda kv: -kv[1]):
        print(f"  {k:24} {v}")
    if not totals:
        print("  no model/effort/context-window changes recorded in any scanned session")
    return 0


def cmd_status(args) -> int:
    cfg = load_config()
    print(f"is-gpt-nerfed {VERSION}  ·  ledger {NERFED_HOME}")
    print(f"config: frequency={cfg.get('frequency')} mode={cfg.get('mode')} queries={cfg.get('queries')} parallel={cfg.get('parallel')} "
          f"languages={','.join(cfg.get('languages') or [])} passive={cfg.get('passive')} notify={cfg.get('notify')} halt_on_mismatch={cfg.get('halt_on_mismatch')}")
    evs = tail_jsonl(EVENTS_PATH, 1)
    print(f"last hook event: {evs[0]['ts'] + ' ' + evs[0]['event'] if evs else 'none yet (hooks not firing, or Codex not restarted since install)'}")
    print()
    cutoff = iso(now() - 24 * 3600)
    recent = [s for s in all_sessions() if (s.get("updated") or "") >= cutoff]
    if not recent:
        print("no sessions seen in the last 24h")
    for s in recent[:15]:
        due = probe_due(s, cfg) if s.get("kind") == "main" else False
        hard = sum(1 for e in s.get("evidence") or [] if e.get("severity") == "hard")
        running = s.get("probe_running") or {}
        print(f"  {short(s['sid'], 12):14} {s.get('kind') or '?':8} turns={s.get('turns'):3} model={(s.get('scan') or {}).get('model') or s.get('model') or '?':16} "
              f"probes={len(s.get('probes') or [])} due={'yes' if due else 'no '} running={'yes' if running else 'no '} halt={'yes' if s.get('halt') else 'no '} hard={hard}  cwd={s.get('cwd')}")
    return 0


def cmd_config(args) -> int:
    cfg = load_config()
    if args.action in ("show", "get") and not args.key:
        print(json.dumps(cfg, indent=2))
        return 0
    if args.action == "get":
        print(json.dumps(cfg.get(args.key)))
        return 0
    if args.action == "init":
        if not os.path.exists(CONFIG_PATH):
            ensure_dirs()
            save_config(cfg)
            print(f"wrote defaults to {CONFIG_PATH}")
        else:
            print(f"config exists: {CONFIG_PATH}")
        return 0
    if args.action == "set":
        if not args.key or args.value is None:
            raise SystemExit("usage: nerfed config set <key> <value>")
        if args.key not in DEFAULT_CONFIG:
            raise SystemExit(f"unknown key {args.key}; known: {', '.join(DEFAULT_CONFIG)}")
        cfg[args.key] = coerce_config_value(args.key, args.value)
        ensure_dirs()
        save_config(cfg)
        log_event("config_set", key=args.key, value=cfg[args.key])
        print(f"{args.key} = {json.dumps(cfg[args.key])}")
        return 0
    raise SystemExit("usage: nerfed config [show|get <key>|set <key> <value>|init]")


# ------------------------------------------------------------------------------------------ pet


def cmd_pet(args) -> int:
    cfg = load_config()
    if args.action == "say":
        text = " ".join(args.text) or pet_line("MATCH", top="gpt-6-astra", p=0.99)
        print(pet_card(cfg, args.verdict or "OK", text, []))
        notify(cfg, text, subtitle="is-gpt-nerfed")
        return 0
    if args.action == "preview":
        samples = [("MATCH", pet_line("MATCH", seed="a", top="gpt-6-astra", p=0.97)),
                   ("MISMATCH", pet_line("MISMATCH_downgrade", seed="b", expected="gpt-6-astra", top="gpt-5.6-luna", p=0.91, n=3, q=3)),
                   ("DOWNGRADED!", pet_line("DOWNGRADED_HARD", seed="c", detail="model gpt-6-astra → gpt-reserve with no settings change")),
                   ("INVALID", pet_line("INVALID", seed="d", reason="probe attempted a tool"))]
        for v, q in samples:
            print(pet_card(cfg, v, q, []))
            print()
        return 0
    raise SystemExit("usage: nerfed pet [say <text>|preview]")


# ---------------------------------------------------------------------------------------- setup


def manifest_paths() -> list[str]:
    return [p for p in (os.path.join(PLUGIN_ROOT, ".codex-plugin", "plugin.json"), os.path.join(PLUGIN_ROOT, "plugin.json")) if os.path.exists(p)]


def run(cmd: list[str], timeout: int = 120) -> tuple[int, str]:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:
        return 1, str(e)


def config_toml_text() -> str:
    try:
        with open(os.path.join(CODEX_HOME, "config.toml"), "r", encoding="utf-8") as f:
            return f.read()
    except OSError:
        return ""


def plugin_enabled_in_config() -> bool:
    return bool(re.search(r'\[plugins\."' + re.escape(PLUGIN_NAME) + r'@[^"]+"\]\s*\n\s*enabled\s*=\s*true', config_toml_text()))


def cmd_setup(args) -> int:
    cfg = load_config()
    ensure_dirs()
    root = os.path.dirname(PLUGIN_ROOT)
    print(f"plugin root: {PLUGIN_ROOT}")
    write_bin_hint()
    cb = codex_bin(cfg)
    ok_cli = False
    if cb and not args.no_cli:
        print(f"codex: {cb}")
        rc, out = run([cb, "plugin", "marketplace", "add", root])
        print(f"  marketplace add → rc={rc} {out[:300]}")
        cache_root = os.path.join(CODEX_HOME, "plugins", "cache", PLUGIN_NAME, PLUGIN_NAME)
        previous = [d for d in (os.listdir(cache_root) if os.path.isdir(cache_root) else []) if not d.startswith(".")]
        if plugin_enabled_in_config():  # reinstall: drop the cached copy so Codex picks up the current code
            run([cb, "plugin", "remove", f"{PLUGIN_NAME}@{MARKETPLACE_NAME}"])
        rc2, out2 = run([cb, "plugin", "add", f"{PLUGIN_NAME}@{MARKETPLACE_NAME}"])
        print(f"  plugin add → rc={rc2} {out2[:300]}")
        ok_cli = rc2 == 0 or plugin_enabled_in_config()
        # A running Codex app keeps the hook definitions it loaded, which point at the previous cache directory.
        # Keep every earlier version path resolvable (as a symlink to the new copy) so its hooks do not fail and
        # block tool calls until the app reloads.
        current = os.path.join(cache_root, VERSION)
        if os.path.isdir(current):
            for v in previous:
                old = os.path.join(cache_root, v)
                if v != VERSION and not os.path.exists(old):
                    try:
                        os.symlink(current, old)
                        print(f"  kept previous version path {v} → {VERSION} for the running Codex app")
                    except OSError as e:
                        print(f"  could not link {v}: {e}")
            # Fallback the hook command uses when PLUGIN_ROOT is stale. It points at the marketplace source (the
            # checkout or the app bundle), which survives version bumps; Codex deletes old cache directories.
            stable = os.path.join(NERFED_HOME, "plugin")
            source = current if "/plugins/cache/" in PLUGIN_ROOT else PLUGIN_ROOT
            try:
                if os.path.islink(stable) or os.path.exists(stable):
                    os.remove(stable) if os.path.islink(stable) else shutil.rmtree(stable)
                os.symlink(source, stable)
            except OSError as e:
                print(f"  could not update {stable}: {e}")
    if not ok_cli:
        print("falling back to manual registration in ~/.codex/config.toml")
        text = config_toml_text()
        block = ""
        if f"[marketplaces.{MARKETPLACE_NAME}]" not in text:
            block += f'\n[marketplaces.{MARKETPLACE_NAME}]\nsource_type = "local"\nsource = "{root}"\n'
        if not plugin_enabled_in_config():
            block += f'\n[plugins."{PLUGIN_NAME}@{MARKETPLACE_NAME}"]\nenabled = true\n'
        if block:
            with open(os.path.join(CODEX_HOME, "config.toml"), "a", encoding="utf-8") as f:
                f.write(block)
            print("  appended:" + block)
    if not os.path.exists(CONFIG_PATH):
        save_config(cfg)
        print(f"wrote {CONFIG_PATH}")
    log_event("setup", plugin_root=PLUGIN_ROOT, via_cli=ok_cli)
    # Hook trust: Codex skips hooks it has not been told to trust (the /hooks screen in the TUI). Offer to record it.
    if cb and not getattr(args, "no_trust", False):
        try:
            hooks = cas.list_plugin_hooks(cb, f"{PLUGIN_NAME}@{MARKETPLACE_NAME}")
        except Exception as e:
            hooks = []
            print(f"could not list hooks: {e}")
        pending = [h for h in hooks if h.get("trustStatus") != "trusted"]
        if pending:
            print(f"\n{len(pending)} hook(s) need trust before Codex will run them:")
            for h in pending:
                print(f"  {h.get('eventName'):18} {h.get('command')}")
            yes = bool(getattr(args, "trust_hooks", False))
            if not yes and sys.stdin.isatty():
                yes = input("Trust these hooks now? [y/N] ").strip().lower() in ("y", "yes")
            if yes:
                cas.trust_hooks(cb, pending)
                log_event("hooks_trust", count=len(pending), events=[h.get("eventName") for h in pending], source="setup")
                print("trusted.")
            else:
                print(f"skipped; run `{DGC_BIN} hooks trust` later (or /hooks in the Codex TUI).")
        elif hooks:
            print(f"\nall {len(hooks)} hooks already trusted")
        hooks_status(cfg, force=True)
    print()
    return cmd_doctor(args)


def cmd_teardown(args) -> int:
    cfg = load_config()
    cb = codex_bin(cfg)
    if cb:
        print(run([cb, "plugin", "remove", f"{PLUGIN_NAME}@{MARKETPLACE_NAME}"])[1][:300])
        print(run([cb, "plugin", "marketplace", "remove", MARKETPLACE_NAME])[1][:300])
    path = os.path.join(CODEX_HOME, "config.toml")
    text = config_toml_text()
    new = re.sub(r'\n\[marketplaces\.' + re.escape(MARKETPLACE_NAME) + r'\]\n(?:[^\[\n][^\n]*\n)*', "\n", text)
    new = re.sub(r'\n\[plugins\."' + re.escape(PLUGIN_NAME) + r'@[^"]+"\]\n(?:[^\[\n][^\n]*\n)*', "\n", new)
    if new != text:
        with open(path, "w", encoding="utf-8") as f:
            f.write(new)
        print("removed is-gpt-nerfed entries from config.toml")
    if args.purge:
        shutil.rmtree(NERFED_HOME, ignore_errors=True)
        print(f"purged {NERFED_HOME}")
    log_event("teardown", purge=bool(getattr(args, "purge", False)))
    print("done. Restart the Codex app to drop the hooks.")
    return 0


def cmd_doctor(args) -> int:
    cfg = load_config()
    problems = 0

    def check(ok: bool, label: str, hint: str = ""):
        nonlocal problems
        print(f"  {'✅' if ok else '❌'} {label}" + (f"  → {hint}" if (not ok and hint) else ""))
        if not ok:
            problems += 1

    print(f"is-gpt-nerfed doctor (v{VERSION})")
    upd = update_status()
    print("  update check: " + ("off" if not upd["enabled"] else
                                (f"{upd['latest']} available at {upd['url']}" if upd["available"] else
                                 f"latest known {upd['latest'] or '?'} ({upd['checked_ago'] or 'never checked'})" + (f" · {upd['error']}" if upd.get("error") else ""))))
    check(sys.version_info >= (3, 9), f"python {sys.version.split()[0]}", "needs Python 3.9+")
    check(os.path.isdir(CODEX_HOME), f"CODEX_HOME {CODEX_HOME}", "Codex not installed?")
    cb = codex_bin(cfg)
    check(bool(cb), f"codex binary: {cb or 'not found'}", "set config codex_bin or put codex on PATH")
    check(os.path.exists(os.path.join(SKILL_DIR, "SKILL.md")), f"skill {os.path.join(SKILL_DIR, 'SKILL.md')}")
    prov = read_json(os.path.join(PLUGIN_ROOT, "assets", "modeltrace", "provenance.json"), {}) or {}
    bank_ok = os.path.exists(BANK_PATH)
    if bank_ok:
        import hashlib
        with open(BANK_PATH, "rb") as f:
            digest = hashlib.sha256(f.read()).hexdigest()
        bank_ok = digest == prov.get("sha256")
    check(bank_ok, f"ModelTrace bank {'sha256 matches provenance' if bank_ok else 'missing or modified'} ({len(prov.get('models') or [])} models)")
    mps = manifest_paths()
    check(bool(mps), "plugin manifest present", "expected plugin/.codex-plugin/plugin.json")
    for p in mps:
        m = read_json(p, {}) or {}
        hooks = m.get("hooks") or ((m.get("extensions") or {}).get("com.openai") or {}).get("hooks")
        text = json.dumps(hooks) if hooks else ""
        check(bool(hooks), f"hooks declared in {os.path.relpath(p, PLUGIN_ROOT)}")
        check("${PLUGIN_ROOT" in text and "exit 0" in text,
              "hook commands locate the plugin through ${PLUGIN_ROOT} and never block when the file is missing")
    stable = os.path.join(NERFED_HOME, "plugin")
    check(os.path.exists(os.path.join(stable, "skills", "is-gpt-nerfed", "scripts", "nerfed")) if os.path.exists(CONFIG_PATH) else True,
          f"fallback plugin path {stable} → {os.path.realpath(stable) if os.path.exists(stable) else 'missing'}", "run ./install.sh")
    text = config_toml_text()
    check(plugin_enabled_in_config(), f'[plugins."{PLUGIN_NAME}@…"] enabled = true in config.toml', "run ./install.sh")
    check(not re.search(r"\[features\][^\[]*hooks\s*=\s*false", text), "hooks feature not disabled in config.toml")
    hs = hooks_status(cfg, force=bool(getattr(args, "live", False)))
    if hs.get("state") == "trusted":
        check(True, f"hooks trusted by Codex ({hs.get('trusted')}/{hs.get('total')}, checked {hs.get('checked_ago')})")
    elif hs.get("state") == "untrusted":
        check(False, f"hooks not trusted ({hs.get('trusted')}/{hs.get('total')})", f"run `{DGC_BIN} hooks trust`")
    elif hs.get("state") == "missing":
        check(False, "Codex does not list this plugin's hooks", "run ./install.sh, then restart the Codex app")
    else:
        print(f"  ⚠️  hook trust unknown ({hs.get('error') or 'not checked yet'})")
    evs = tail_jsonl(EVENTS_PATH, 1)
    recent = bool(evs) and evs[0].get("ts", "") >= iso(now() - 48 * 3600)
    print(f"  {'✅' if recent else '⚠️ '} hook events seen: {evs[0]['ts'] + ' ' + evs[0]['event'] if evs else 'none yet'}"
          + ("" if recent else "  → restart the Codex app, send any message, then re-run doctor"))
    print(f"  {'✅' if hs.get('desktop_loaded') else '⚠️ '} Codex Desktop has fired these hooks: "
          + (f"yes, last {hs.get('last_desktop_event_ago')}" if hs.get("desktop_loaded") else "not yet  → the desktop app loads plugins and hook trust at start: quit and reopen it"))
    if hs.get("desktop_loaded") and not hs.get("desktop_loaded_current"):
        print(f"  ⚠️  none since this version was installed ({hs.get('installed_ago')}); the desktop may still run the previous copy → quit and reopen it if this persists")
    try:
        parse_frequency(cfg.get("frequency"))
        check(True, f"frequency {cfg.get('frequency')!r}, mode {cfg.get('mode')!r}, queries {cfg.get('queries')}")
    except ValueError as e:
        check(False, str(e))
    if getattr(args, "fork", False):
        tid = args.thread
        if not tid:
            rows = db_recent_main_threads(1)
            tid = rows[0]["id"] if rows else None
        if not tid or not cb:
            check(False, "fork doctor needs a session id and a codex binary")
        else:
            try:
                r = cas.fork_doctor(cb, tid)
                check(True, f"ephemeral fork of {short(tid, 12)} ({r['model']} @ {r['effort']}) created in {r['elapsed_s']}s with 0 inference requests")
            except Exception as e:
                check(False, f"ephemeral fork failed: {e}")
    if os.path.exists(ERRORS_PATH):
        try:
            last = open(ERRORS_PATH).read().strip().splitlines()[-1][:160]
            print(f"  ⚠️  errors logged in {ERRORS_PATH} (last: {last})")
        except Exception:
            pass
    print(f"{'all good' if not problems else str(problems) + ' problem(s)'} — next: restart the Codex app, then in any session say  {SKILL_CMD}")
    return 0 if not problems else 1


# ------------------------------------------------------------------------------------- selftest


def cmd_selftest(args) -> int:
    import tempfile
    global NERFED_HOME, CONFIG_PATH, EVENTS_PATH, PROBES_INDEX, SESSIONS_DIR, PROBES_DIR, ERRORS_PATH, WORKER_LOG
    tmp = tempfile.mkdtemp(prefix="dgc-selftest-")
    NERFED_HOME = tmp
    CONFIG_PATH, EVENTS_PATH, PROBES_INDEX = os.path.join(tmp, "config.json"), os.path.join(tmp, "events.jsonl"), os.path.join(tmp, "probes.jsonl")
    SESSIONS_DIR, PROBES_DIR, ERRORS_PATH, WORKER_LOG = os.path.join(tmp, "sessions"), os.path.join(tmp, "probes"), os.path.join(tmp, "errors.log"), os.path.join(tmp, "worker.log")
    ensure_dirs()
    fails = 0

    def expect(cond, label):
        nonlocal fails
        print(f"  {'ok ' if cond else 'FAIL'} {label}")
        fails += 0 if cond else 1

    bank = load_bank()
    expect(len(core.bank_model_ids(bank)) >= 6, f"fingerprint bank loaded: {len(core.bank_model_ids(bank))} models")
    fixture = os.path.join(os.path.dirname(PLUGIN_ROOT), "tests", "fixtures", "reference_subset.jsonl")
    rows = list(iter_jsonl(fixture))
    if rows:
        hits = 0
        for r in rows:
            a = core.analyze_global_outputs([{"text": r["text"], "expected_count": r["requested_count"]}], bank)
            hits += a["prediction"] == r["model_id"]
        expect(hits >= 0.8 * len(rows), f"reference outputs attributed to their own model: {hits}/{len(rows)}")
    else:
        print("  skip reference fixture not found")
    expect(core.parse_numbers("Sure: [12, 355, 0, 400, 7] and then 9") == [12, 355, 7] or core.parse_numbers("[12, 355, 0, 400, 7]") == [12, 355, 7], "number parsing keeps 1..355 only")
    expect(model_rank("gpt-6-astra") > model_rank("gpt-5.6-sol") > model_rank("gpt-5.3-codex-spark"), "model ranking by family/size")
    expect(classify_change("gpt-6-astra", "gpt-reserve") == "downgrade", "gpt-reserve counts as a downgrade")
    expect(parse_frequency("turns:8") == ("turns", 8) and parse_frequency("30m") == ("minutes", 30) and parse_frequency("manual") == ("manual", 0), "frequency parsing")
    rp = os.path.join(tmp, "rollout.jsonl")
    with open(rp, "w") as f:
        f.write(json.dumps({"type": "turn_context", "timestamp": "t1", "payload": {"turn_id": "1", "model": "gpt-6-astra", "collaboration_mode": {"settings": {"reasoning_effort": "max"}}}}) + "\n")
        f.write(json.dumps({"type": "event_msg", "payload": {"type": "token_count", "info": {"model_context_window": 258400}}}) + "\n")
        f.write(json.dumps({"type": "turn_context", "timestamp": "t2", "payload": {"turn_id": "2", "model": "gpt-reserve", "collaboration_mode": {"settings": {"reasoning_effort": "medium"}}}}) + "\n")
        f.write(json.dumps({"type": "event_msg", "payload": {"type": "token_count", "info": {"model_context_window": 128000}}}) + "\n")
    scan, ev = scan_full(rp, frozenset({"gpt-reserve"}))
    kinds = {e["kind"]: e["severity"] for e in ev}
    expect(kinds.get("silent_model_change") == "hard" and kinds.get("hidden_model") == "hard" and kinds.get("context_window_change") == "hard", f"passive scan finds silent downgrade: {kinds}")
    st = new_session("s1")
    st["kind"], st["turns"] = "main", 8
    expect(probe_due(st, {"frequency": "turns:8", "nudge_cooldown_turns": 4}), "probe due after N turns")
    fake = {"prediction": "gpt-5.6-luna", "probability": 0.9, "used_outputs": 3,
            "results": [{"model": "gpt-5.6-luna", "probability": 0.9, "score": 2.0}, {"model": "gpt-6-astra", "probability": 0.05, "score": 0.2},
                        {"model": "gpt-5.5", "probability": 0.05, "score": 0.1}],
            "family_probabilities": [], "diagnostics": [], "calibration": {"queries": "3", "beta": 12, "cv_accuracy": 1.0}}
    expect(fingerprint_verdict("gpt-6-astra", fake, []) == ("MISMATCH", "downgrade"), "expected ≠ fingerprint → MISMATCH downgrade")
    expect(fingerprint_verdict("gpt-5.6-luna", fake, []) == ("MATCH", None), "expected = fingerprint → MATCH")
    expect(fingerprint_verdict("gpt-7-nova", fake, []) == ("UNLISTED", None), "unknown expected model → UNLISTED")
    expect(fingerprint_verdict("gpt-6-astra", fake, [{"detail": "x"}]) == ("DOWNGRADED!", "hard"), "hard evidence overrides")
    ask = lambda asked, name: server_finding({"ok": True, "requested": asked, "served": name}, {})
    expect(ask("gpt-6-astra", "gpt-6-astra-2026-08-20")["state"] == "same" and ask("gpt-6-astra", "openai/GPT-6-Astra")["state"] == "same",
           "server check: a dated snapshot or a provider prefix is the model asked for")
    expect(ask("gpt-6-astra", "gpt-5.6-luna")["state"] == "downgrade" and ask("gpt-6-astra", "gpt-6-astra-internal-x")["state"] == "unrecognized",
           "server check: a known downgrade counts, an unknown name does not")
    luna_match = assess("gpt-5.6-luna", fake, [])
    expect(combine_with_server(luna_match, ask("gpt-5.6-luna", "gpt-5.5"))["verdict"] == "SUSPICIOUS", "server contradicting a Match: Suspicious, not Downgraded")
    expect(combine_with_server(luna_match, ask("gpt-5.6-luna", "gpt-5.6-luna"))["verdict"] == "MATCH", "server agreeing changes nothing")
    expect(combine_with_server(assess("gpt-6-astra", fake, []), ask("gpt-6-astra", "gpt-6-astra"))["verdict"] == "MISMATCH", "server agreeing cannot clear a Mismatch")
    expect(combine_with_server(assess("gpt-6-astra", None, []), ask("gpt-6-astra", "gpt-5.6-luna"))["verdict"] == "DOWNGRADED!",
           "server's admitted downgrade decides when the fingerprint has no answer")
    shutil.rmtree(tmp, ignore_errors=True)
    print("selftest:", "PASS" if not fails else f"{fails} FAILURE(S)")
    return 0 if not fails else 1


# ------------------------------------------------------------------------------------- method text

METHOD = f"""is-gpt-nerfed — how the verdict is made (v{VERSION})

1. PASSIVE (every turn, zero tokens). Codex writes every session to a rollout JSONL file and records, per turn,
   the model slug and reasoning effort it *asked for* (turn_context), every settings change the app applied
   (thread_settings_applied) and the model context window (token_count). The scanner flags:
     hard  silent_model_change     the model changed between turns with no settings change
     hard  silent_effort_change    reasoning effort dropped with no settings change
     hard  hidden_model            a model the catalog marks visibility=hide (e.g. gpt-reserve) ran a turn
     hard  context_window_change   the context window shrank mid-session (a different model class answered)
     soft  applied_model_change    the app applied a lower-tier model through session settings (you, or the app?)
     soft  service_tier_change     the Fast/priority tier was dropped
     good  model upgrade           the session moved to a newer generation or larger model (a rollout): good news
   Better or worse is not a fixed list: Codex's catalog succession pointer, hidden internal models, the generation
   and size tier in the slug, then the catalog's own ranking decide it (compare_models).
2. ACTIVE (on your schedule, or when you say {SKILL_CMD}). ModelTrace fingerprinting (MIT, xqy2006):
   the session is forked `ephemeral: true` {DEFAULT_CONFIG['queries']} times at its last completed turn — the same mechanism
   as Codex's /side — and each fork is asked for ~300 "random" integers in 1..355 with no tools. The value
   distribution (355-dim Hellinger vector) and an ordered-block feature (4 position blocks × 16 bins + last-digit
   distribution) are compared with per-model centroids after projecting out prompt-induced nuisance directions;
   a calibrated softmax gives closed-set attribution probabilities over the bank's models (GPT samples were
   enrolled from the official Codex subscription; cross-validated accuracy 95.5% with 1 answer, 99.6% with 2,
   100% with 3). Verdict: the session's declared model vs the attribution, behind a confidence gate, because the
   calibrated softmax amplifies small score gaps (a "100%" can hide a thin margin):
     MATCH        top candidate = declared model
     MISMATCH     top candidate ≠ declared model AND p(top) ≥ {DEFAULT_CONFIG['mismatch_confidence']:.0%} AND p(declared) ≤ {1 - DEFAULT_CONFIG['mismatch_confidence']:.0%}
                  AND fused z-score margin ≥ {MARGIN_SIGMA}σ (direction: downgrade / upgrade / lateral by family and size tags)
     SUSPICIOUS   top candidate ≠ declared model but the gate is not met; the runner adds one more round of forks
                  (up to 6 answers) before finalising, and SUSPICIOUS is shown amber, never red
     DOWNGRADED!  hard passive evidence exists, whatever the fingerprint says
     UNLISTED     the declared model is not in the bank (a look-alike is reported, no verdict)
     INVALID      no usable sample (tool use attempted, refusal, truncation, transport error; one automatic retry on transport)
   Inside a /side conversation the model answers the same challenge itself; the numbers stay in the ephemeral
   side session, never in your main context.
3. SERVER CHECK (served_check, on by default; one small request per probe). Before the forks, the probe sends one
   streaming request for the same model and effort to Codex's backend with your ChatGPT access token and reads which
   model the server names (the OpenAI-Model header, which Codex itself checks, or response.model in the first
   event), then closes the connection. It is the server's label, weighed next to the fingerprint, never instead:
     server names the model asked for      no change (a Mismatch stays a Mismatch: the label can be wrong)
     server names a worse or other model   a Match becomes SUSPICIOUS; with no fingerprint verdict (no answers,
                                           an unlisted model, a Suspicious lean) a downgrade decides: DOWNGRADED!
     server names a better model           reported, no change
     unknown name, no answer               reported, no change

WHAT IT CANNOT DO
  • It cannot see which weights actually served a request. "Declared model" is what Codex asked for; the server
    check reports what the server says served it, which is a label too.
  • Attribution is closed-set: a model outside the bank is mapped to its nearest look-alike. A quantised or
    "dumbed-down" variant that keeps the slug only shows up if its number distribution drifts.
  • Probes fork from persisted history: a turn still in flight is not included.
Everything is stored locally under {NERFED_HOME}; nothing is uploaded. Read the ledger yourself: probes/*.json.
Credits: fingerprint bank, scorer and probe prompts from https://github.com/xqy2006/ModelTrace (MIT).
"""


# ---------------------------------------------------------------------------------------- main


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="nerfed", description="is-gpt-nerfed: detect silent model downgrades in Codex sessions")
    p.add_argument("--version", action="version", version=f"nerfed {VERSION}")
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("hook", help="(called by Codex hooks) consume a hook payload on stdin")
    s.add_argument("--event", default=None)
    s.set_defaults(fn=cmd_hook)

    s = sub.add_parser("probe", help="run or answer a fingerprint probe")
    ps = s.add_subparsers(dest="probe_cmd")
    a = ps.add_parser("now", help="probe the current session (forks it ephemerally; self-answer mode inside /side)")
    a.add_argument("--thread", help="session id (default: $CODEX_THREAD_ID)")
    a.add_argument("--queries", type=int, default=None)
    a.add_argument("--mode", choices=["auto", "fork", "self"], default="auto")
    a.add_argument("--force", action="store_true", help="run inline even inside a network-less sandbox")
    a.add_argument("--no-pick", action="store_true", help="skip the interactive picker and guess the session")
    a.add_argument("--originator", help="identify the probe as this client (default: the session's own, e.g. 'Codex Desktop')")
    a.set_defaults(fn=cmd_probe_now)
    a = ps.add_parser("fresh", help="global probe: brand-new ephemeral sessions with the default model, no history")
    a.add_argument("--model", help="model slug (default: config.toml model)")
    a.add_argument("--effort", help="reasoning effort (default: config.toml)")
    a.add_argument("--queries", type=int, default=None)
    a.add_argument("--originator", help="identify the probe as this client (default: 'Codex Desktop' with the app's binary, else codex_cli_rs)")
    a.set_defaults(fn=cmd_probe_fresh)
    a = ps.add_parser("submit-numbers", help="(self-answer mode) submit one challenge answer")
    a.add_argument("probe_id")
    a.add_argument("--numbers", help="JSON integer array (or any text containing the integers)")
    a.add_argument("--numbers-file")
    a.add_argument("--final", action="store_true", help="score now even if fewer challenges were answered")
    a.set_defaults(fn=cmd_probe_submit_numbers)
    a = ps.add_parser("list")
    a.add_argument("--last", type=int, default=20)
    a.set_defaults(fn=lambda args: cmd_report(argparse.Namespace(last=args.last)))

    s = sub.add_parser("worker", help="(background) run one fork probe for a session, or --fresh for a global probe")
    s.add_argument("--thread")
    s.add_argument("--fresh", action="store_true")
    s.add_argument("--model")
    s.add_argument("--effort")
    s.add_argument("--queries", type=int, default=None)
    s.set_defaults(fn=cmd_worker)
    s = sub.add_parser("resume", help="clear a halt on a session (only when the user asks)")
    s.add_argument("--thread")
    s.set_defaults(fn=cmd_resume)
    s = sub.add_parser("report", help="table of all probes + passive findings")
    s.add_argument("--last", type=int, default=30)
    s.set_defaults(fn=cmd_report)
    s = sub.add_parser("explain", help="show one probe in detail, or --method")
    s.add_argument("probe_id", nargs="?")
    s.add_argument("--method", action="store_true")
    s.set_defaults(fn=cmd_explain)
    s = sub.add_parser("evidence", help="passive findings per session")
    s.add_argument("--thread")
    s.add_argument("--all", action="store_true")
    s.set_defaults(fn=cmd_evidence)
    s = sub.add_parser("scan", help="scan one rollout file now")
    s.add_argument("--thread")
    s.add_argument("--rollout")
    s.set_defaults(fn=cmd_scan)
    s = sub.add_parser("served", help="ask the server which model it says answers a request for this model (one small request, no fingerprint)")
    s.add_argument("--model", help="model slug to ask about (default: the model a new session would use)")
    s.add_argument("--effort", help="reasoning effort to ask with (default: a new session's)")
    s.add_argument("--originator", help="identify the check as this client (default: as the probes do)")
    s.set_defaults(fn=cmd_served)
    s = sub.add_parser("audit", help="scan every rollout modified in the last N days")
    s.add_argument("--days", type=float, default=7)
    s.add_argument("--include-subagents", action="store_true")
    s.set_defaults(fn=cmd_audit)
    s = sub.add_parser("status", help="config + recently seen sessions")
    s.set_defaults(fn=cmd_status)
    s = sub.add_parser("hooks", help="status | trust — trust state of the plugin's hooks as Codex sees them")
    s.add_argument("action", nargs="?", choices=["status", "trust"], default="status")
    s.set_defaults(fn=cmd_hooks)
    s = sub.add_parser("log", help="activity log: account switches, schedule decisions, probes, findings, errors")
    s.add_argument("--last", type=int, default=40)
    s.add_argument("--since", help="e.g. 30m, 2h, 1d")
    s.add_argument("--kind", help="comma-separated kinds, e.g. probe_verdict,account_switch")
    s.add_argument("--probe")
    s.add_argument("--thread")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_log)
    s = sub.add_parser("tick", help="(called by the app) run the probe schedule for threads that are due and active but quiet")
    s.set_defaults(fn=cmd_tick)
    s = sub.add_parser("snapshot", help="JSON feed for the menu-bar app: sessions, latest probes, config")
    s.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    s.add_argument("--pretty", action="store_true")
    s.add_argument("--demo", action="store_true", help="synthetic English sample data (for screenshots)")
    s.add_argument("--hours", type=float, default=48)
    s.set_defaults(fn=cmd_snapshot)
    s = sub.add_parser("config", help="show / get / set / init")
    s.add_argument("action", nargs="?", default="show")
    s.add_argument("key", nargs="?")
    s.add_argument("value", nargs="?")
    s.set_defaults(fn=cmd_config)
    s = sub.add_parser("pet", help="say <text> | preview — the persona that delivers verdicts")
    s.add_argument("action")
    s.add_argument("text", nargs="*")
    s.add_argument("--verdict")
    s.set_defaults(fn=cmd_pet)
    s = sub.add_parser("setup", help="register the plugin with Codex (used by install.sh)")
    s.add_argument("--no-cli", action="store_true", help="skip `codex plugin …` and edit config.toml directly")
    s.add_argument("--trust-hooks", action="store_true", help="record trust for the plugin's hooks without asking")
    s.add_argument("--no-trust", action="store_true", help="do not touch hook trust")
    s.add_argument("--fork", action="store_true", help=argparse.SUPPRESS)
    s.add_argument("--thread", help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_setup)
    s = sub.add_parser("teardown", help="unregister the plugin (used by uninstall.sh)")
    s.add_argument("--purge", action="store_true", help="also delete the ledger")
    s.set_defaults(fn=cmd_teardown)
    s = sub.add_parser("update-check", help="ask GitHub for the latest release once (the app does this every 10 min while check_updates is on)")
    s.set_defaults(fn=cmd_update_check)
    s = sub.add_parser("update-install", help="download the latest release, replace the app and relaunch it (what the panel's update link does)")
    s.add_argument("--app", help="path of the installed IsGPTNerfed.app (default: ~/Applications, then /Applications)")
    s.add_argument("--pid", help="pid of the running app, stopped before the swap")
    s.add_argument("--backup-dir", help="where the previous copy goes (default: the Trash)")
    s.add_argument("--no-launch", action="store_true", help="do not relaunch afterwards")
    s.add_argument("--force", action="store_true", help="install even if the release is not newer")
    s.set_defaults(fn=cmd_update_install)
    s = sub.add_parser("doctor", help="check the installation; --fork also creates a real ephemeral fork (no inference)")
    s.add_argument("--fork", action="store_true")
    s.add_argument("--live", action="store_true", help="re-query hook trust instead of using the cached answer")
    s.add_argument("--thread")
    s.add_argument("--no-cli", action="store_true", help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_doctor)
    s = sub.add_parser("selftest", help="run built-in checks")
    s.set_defaults(fn=cmd_selftest)
    return p


def main(argv=None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "hook":
        # A hook must never fail. Codex reads a non-zero exit as a reason to stop the user's turn (argparse exits
        # with 2, which Codex treats as "block"), so hook arguments are parsed loosely and everything is swallowed.
        event = None
        for i, a in enumerate(argv[1:], 1):
            if a == "--event" and i + 1 < len(argv):
                event = argv[i + 1]
            elif a.startswith("--event=") or (a.startswith("--event") and len(a) > len("--event")):
                event = a.split("=", 1)[1] if "=" in a else a[len("--event"):]
        try:
            return cmd_hook(argparse.Namespace(cmd="hook", event=event))
        except BaseException as e:  # noqa: BLE001 — includes SystemExit
            log_error(f"hook crashed: {e!r}")
            return 0
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "fn", None):
        parser.print_help()
        return 0
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
